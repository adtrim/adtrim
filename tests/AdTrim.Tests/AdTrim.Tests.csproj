<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AdTrim.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned (May 2026): xUnit 2.9.3 + AwesomeAssertions.
         xUnit v2 deliberately (not v3) for training-data depth.
         AwesomeAssertions is the Apache-2.0 fork of FluentAssertions v7
         (avoids Xceed license risk). -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <!-- We link source files instead of project-referencing the WPF project,
       because referencing a net10.0-windows project from net10.0 isn't
       supported. When a Core (non-WPF) class library is split out later,
       this becomes a normal ProjectReference. -->
  <ItemGroup>
    <Compile Include="..\..\src\AdTrim\AppVersion.cs"         Link="AppVersion.cs"/>
    <Compile Include="..\..\src\AdTrim\Models\Confidence.cs"  Link="Models\Confidence.cs"/>
    <Compile Include="..\..\src\AdTrim\Models\MediaInfo.cs"   Link="Models\MediaInfo.cs"/>
