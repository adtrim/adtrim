    <Compile Include="..\..\src\AdTrim\Models\Split.cs"       Link="Models\Split.cs"/>
    <Compile Include="..\..\src\AdTrim\Models\Segment.cs"     Link="Models\Segment.cs"/>
    <Compile Include="..\..\src\AdTrim\Models\StatusModel.cs" Link="Models\StatusModel.cs"/>
    <Compile Include="..\..\src\AdTrim\Models\TimelineThumbnail.cs" Link="Models\TimelineThumbnail.cs"/>
    <Compile Include="..\..\src\AdTrim\Models\RefineResult.cs" Link="Models\RefineResult.cs"/>
    <Compile Include="..\..\src\AdTrim\Models\ExportPlan.cs"  Link="Models\ExportPlan.cs"/>
    <Compile Include="..\..\src\AdTrim\Commands\CommandStack.cs" Link="Commands\CommandStack.cs"/>
    <Compile Include="..\..\src\AdTrim\Commands\EditCommands.cs" Link="Commands\EditCommands.cs"/>
    <Compile Include="..\..\src\AdTrim\Commands\RefineCommands.cs" Link="Commands\RefineCommands.cs"/>
    <Compile Include="..\..\src\AdTrim\ViewModels\MainViewModel.cs" Link="ViewModels\MainViewModel.cs"/>
    <Compile Include="..\..\src\AdTrim\Services\FfmpegRunner.cs"          Link="Services\FfmpegRunner.cs"/>
    <Compile Include="..\..\src\AdTrim\Services\MediaProbeService.cs"     Link="Services\MediaProbeService.cs"/>
