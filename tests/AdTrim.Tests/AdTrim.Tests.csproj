    <Compile Include="..\..\src\AdTrim\Services\ThumbnailService.cs"      Link="Services\ThumbnailService.cs"/>
    <Compile Include="..\..\src\AdTrim\Services\FrameSnap.cs"             Link="Services\FrameSnap.cs"/>
    <Compile Include="..\..\src\AdTrim\Services\RefineService.cs"         Link="Services\RefineService.cs"/>
    <Compile Include="..\..\src\AdTrim\Services\ProjectStore.cs"          Link="Services\ProjectStore.cs"/>
