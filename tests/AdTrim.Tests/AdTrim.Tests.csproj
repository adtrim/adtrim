<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only like the app it references. UseWPF stays off: it would drop System.IO from
         the implicit usings the tests rely on. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AdTrim.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The app itself, so view models and everything else it contains can be tested without
         listing source files here. Its internals are visible to this assembly. -->
    <ProjectReference Include="..\..\src\AdTrim\AdTrim.csproj" />
    <!-- Pinned (May 2026): xUnit 2.9.3 + AwesomeAssertions.
         xUnit v2 deliberately (not v3).
         AwesomeAssertions is the Apache-2.0 fork of FluentAssertions v7
         (avoids Xceed license risk). -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>
</Project>
