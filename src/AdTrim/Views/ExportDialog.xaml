<Window x:Class="AdTrim.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AdTrim.Converters"
        xmlns:vm="clr-namespace:AdTrim.ViewModels"
        Title="Export merged MP4"
        Width="640" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.UI}">

  <Window.Resources>
    <conv:TimeFormatConverter x:Key="TimeFmt"/>
    <conv:StatusKindToBrushConverter x:Key="StatusKindBrush"/>
    <conv:StatusKindToBannerBgConverter x:Key="StatusKindBannerBg"/>
    <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
    <conv:BoolToCollapsedConverter x:Key="Bool2Collapse"/>
    <conv:ProgressTrackWidthConverter x:Key="ProgressTrackWidth"/>
  </Window.Resources>

  <!-- Dialog body -->
  <Border Background="{StaticResource Bg.Surface}"
          BorderBrush="{StaticResource Border.Strong}" BorderThickness="1"
          CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="64" ShadowDepth="24" Direction="270"
                        Color="Black" Opacity="0.55"/>
    </Border.Effect>

    <Grid>
      <!-- ====================================================== -->
      <!-- CONFIGURING VIEW                                        -->
      <!-- ====================================================== -->
      <Grid Visibility="{Binding IsConfiguring, Converter={StaticResource Bool2Vis}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>   <!-- Header -->
          <RowDefinition Height="Auto"/>   <!-- Summary stats -->
          <RowDefinition Height="Auto"/>   <!-- Output folder -->
          <RowDefinition Height="Auto"/>   <!-- Output filename -->
          <RowDefinition Height="Auto"/>   <!-- Post-export options -->
          <RowDefinition Height="Auto"/>   <!-- Warning banner -->
          <RowDefinition Height="*"/>      <!-- Spacer -->
          <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0">
          <TextBlock Text="Export merged MP4" Style="{StaticResource Text.DialogTitle}"/>
          <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="13" Margin="0,4,0,0"
                     TextWrapping="Wrap">
            Excluded segments will be cut and the remaining parts merged into a single file.
          </TextBlock>
        </StackPanel>

        <!-- Summary stats. Time values are TextBoxes via SelectableText so the
             user can highlight + copy them. The primary Export action lives in
             the footer (bottom-right) to match the progress modal's "Run in
             background" button. -->
        <Border Grid.Row="1" Margin="24,20,24,0"
                Background="{StaticResource Bg.Surface2}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                CornerRadius="6" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="SOURCE" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBox Style="{StaticResource SelectableText}"
                       Text="{Binding SourceDurationUs, Converter={StaticResource TimeFmt}, Mode=OneWay}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                       Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Border.Subtle}" Margin="0,0,14,0"/>

            <StackPanel Grid.Column="2">
              <TextBlock Text="EXCLUDED" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBox Style="{StaticResource SelectableText}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                       Foreground="{StaticResource State.Warning}" Margin="0,2,0,0"
                       Text="{Binding ExcludedDurationUs, Converter={StaticResource TimeFmt}, StringFormat=−{0}, Mode=OneWay}"/>
            </StackPanel>

            <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Border.Subtle}" Margin="0,0,14,0"/>

            <StackPanel Grid.Column="4">
              <TextBlock Text="FINAL" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBox Style="{StaticResource SelectableText}"
                       Text="{Binding FinalDurationUs, Converter={StaticResource TimeFmt}, Mode=OneWay}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                       Foreground="{StaticResource State.Success}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Output folder -->
        <StackPanel Grid.Row="2" Margin="24,20,24,0">
          <TextBlock Text="Output folder" Style="{StaticResource DialogFieldLabel}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     FontFamily="{StaticResource Font.Mono}" FontSize="13"
                     Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseFolder"/>
          </Grid>
        </StackPanel>

        <!-- Output filename -->
        <StackPanel Grid.Row="3" Margin="24,14,24,0">
          <Grid Margin="0,0,0,6">
            <TextBlock Text="Output filename" Style="{StaticResource DialogFieldLabel}" Margin="0"/>
            <TextBlock Text=".mp4 added automatically" HorizontalAlignment="Right"
                       Foreground="{StaticResource Text.Tertiary}" FontSize="12"/>
          </Grid>
          <TextBox FontFamily="{StaticResource Font.Mono}"
                   Text="{Binding OutputFilename, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Post-export options. Plain checkboxes, no fancy chrome - these   -->
        <!-- are "tick before pressing Export" toggles, not validation state. -->
        <StackPanel Grid.Row="4" Margin="24,14,24,0">
          <CheckBox Content="Delete project sidecar (.adt.json) after successful export"
                    IsChecked="{Binding DeleteSidecarAfterExport, Mode=TwoWay}"
                    Foreground="{StaticResource Text.Secondary}"
                    FontSize="12"/>
        </StackPanel>

        <!-- Inline validation banner - one row per issue, kind-colored.        -->
        <!-- Empty collection collapses the row. ScrollViewer caps growth so    -->
        <!-- adding/removing issues doesn't resize the (fixed-height) window -  -->
        <!-- previously this row + SizeToContent="Height" produced visible      -->
        <!-- flicker as validation churned during typing.                        -->
        <ScrollViewer Grid.Row="5" Margin="24,14,24,0" MaxHeight="140"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding ValidationIssues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{Binding Kind, Converter={StaticResource StatusKindBannerBg}}"
                      BorderBrush="{Binding Kind, Converter={StaticResource StatusKindBrush}}"
                      BorderThickness="0,0,0,0"
                      CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <Path Width="14" Height="14" Stretch="Uniform" Margin="0,1,10,0"
                        Stroke="{Binding Kind, Converter={StaticResource StatusKindBrush}}"
                        StrokeThickness="1.6"
                        Fill="Transparent" StrokeLineJoin="Round"
                        Data="M12,4 L21,20 L3,20 Z M12,10 L12,14 M12,17 L12,17"/>
                  <TextBlock Text="{Binding Message}" VerticalAlignment="Center"
                             Foreground="{StaticResource Text.Primary}"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>

        <!-- Footer: Cancel bottom-left, Export bottom-right - matches the
             progress modal where Cancel-export sits on the left and Run-in-
             background sits on the right. -->
        <Border Grid.Row="7" Background="Transparent"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="20,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Click="OnCancel"/>
            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Click="OnExport"
                    Padding="14,8">
              <StackPanel Orientation="Horizontal">
                <Path Width="13" Height="13" Stretch="Uniform"
                      Stroke="White" StrokeThickness="1.6" Fill="Transparent"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20"
                      Margin="0,0,6,0"/>
                <TextBlock Text="{Binding ExportButtonText}" Foreground="White"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Grid>

      <!-- ====================================================== -->
      <!-- PROGRESS / TERMINAL VIEW                                -->
      <!-- ====================================================== -->
      <Grid Visibility="{Binding IsConfiguring, Converter={StaticResource Bool2Collapse}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>   <!-- Header -->
          <RowDefinition Height="Auto"/>   <!-- Output destination card -->
          <RowDefinition Height="Auto"/>   <!-- Duration stats -->
          <RowDefinition Height="Auto"/>   <!-- Progress line + bar -->
          <RowDefinition Height="Auto"/>   <!-- Elapsed / remaining row -->
          <RowDefinition Height="Auto"/>   <!-- Error banner (terminal failed only) -->
          <RowDefinition Height="Auto"/>   <!-- Parts list -->
          <RowDefinition Height="*"/>      <!-- Spacer -->
          <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0" Orientation="Horizontal">
          <!-- Rotating arc while exporting; gradient square on success; red X
               on cancel / failure. -->
          <Grid Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top">
            <Border Width="12" Height="12" CornerRadius="3"
                    Visibility="{Binding IsCompleted, Converter={StaticResource Bool2Vis}}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{StaticResource Accent.Base.Color}" Offset="0"/>
                  <GradientStop Color="#FF6B5DFF" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Path Stretch="Uniform"
                  Stroke="{StaticResource Accent.Base}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Fill="Transparent"
                  Data="M 6,1 A 5,5 0 1 1 1,6"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="{Binding IsExporting, Converter={StaticResource Bool2Vis}}">
              <Path.RenderTransform>
                <RotateTransform Angle="0"/>
              </Path.RenderTransform>
              <Path.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                        From="0" To="360" Duration="0:0:1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Path.Triggers>
            </Path>
            <Path Width="12" Height="12" Stretch="Uniform"
                  Stroke="{StaticResource State.Danger}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M6,6 L18,18 M18,6 L6,18"
                  Visibility="{Binding IsFailed, Converter={StaticResource Bool2Vis}}"/>
          </Grid>
          <StackPanel>
            <TextBlock Style="{StaticResource Text.DialogTitle}"
                       Visibility="{Binding IsExporting, Converter={StaticResource Bool2Vis}}"
                       Text="Exporting merged MP4"/>
            <TextBlock Style="{StaticResource Text.DialogTitle}"
                       Visibility="{Binding IsCompleted, Converter={StaticResource Bool2Vis}}"
                       Text="Export complete"/>
            <TextBlock Style="{StaticResource Text.DialogTitle}"
                       Visibility="{Binding IsFailed, Converter={StaticResource Bool2Vis}}"
                       Text="Export stopped"/>
            <TextBlock Text="{Binding ExportSummaryLine}"
                       Foreground="{StaticResource Text.Secondary}" FontSize="13" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>

        <!-- Output destination card -->
        <Border Grid.Row="1" Margin="24,18,24,0"
                Background="{StaticResource Bg.Surface2}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                CornerRadius="6" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="SAVING TO"
                       Style="{StaticResource Text.SectionLabel}"
                       Foreground="{StaticResource Text.Tertiary}" FontSize="11"
                       Margin="0,0,18,4" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding OutputFolder}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="13"
                       Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="FILENAME"
                       Style="{StaticResource Text.SectionLabel}"
                       Foreground="{StaticResource Text.Tertiary}" FontSize="11"
                       Margin="0,0,18,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding OutputFilename}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="13"
                       Foreground="{StaticResource Text.Primary}"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>

        <!-- Duration stats (reuse the same three-column layout from configuring view) -->
        <Border Grid.Row="2" Margin="24,12,24,0"
                Background="{StaticResource Bg.Surface2}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                CornerRadius="6" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="SOURCE" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBlock Text="{Binding SourceDurationUs, Converter={StaticResource TimeFmt}}"
                         FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                         Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
            </StackPanel>
            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Border.Subtle}" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="2">
              <TextBlock Text="EXCLUDED" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                         Foreground="{StaticResource State.Warning}" Margin="0,2,0,0"
                         Text="{Binding ExcludedDurationUs, Converter={StaticResource TimeFmt}, StringFormat=−{0}}"/>
            </StackPanel>
            <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Border.Subtle}" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="4">
              <TextBlock Text="FINAL" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBlock Text="{Binding FinalDurationUs, Converter={StaticResource TimeFmt}}"
                         FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                         Foreground="{StaticResource State.Success}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Progress line + bar -->
        <Grid Grid.Row="3" Margin="24,16,24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0"
                     Text="{Binding ProgressLine}"
                     FontFamily="{StaticResource Font.Mono}" FontSize="12"
                     Foreground="{StaticResource Text.Secondary}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Row="0" Grid.Column="1"
                     Text="{Binding ProgressPercentText}"
                     FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Medium"
                     Foreground="{StaticResource Text.Primary}"/>
          <Border Grid.Row="1" Grid.ColumnSpan="2" Height="6"
                  Background="{StaticResource Bg.Lane}" CornerRadius="3" Margin="0,8,0,0">
            <Rectangle HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Height="6"
                       Width="{Binding ProgressPercent, Converter={StaticResource ProgressTrackWidth}, ConverterParameter=592}">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="{StaticResource Accent.Base.Color}" Offset="0"/>
                  <GradientStop Color="#FF7C6BFF" Offset="1"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
          </Border>
        </Grid>

        <!-- Elapsed / remaining row -->
        <Grid Grid.Row="4" Margin="24,10,24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Column="0">
            <TextBlock Text="Elapsed " Foreground="{StaticResource Text.Tertiary}" FontSize="12"/>
            <TextBlock Text="{Binding ElapsedFormatted}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="12"
                       Foreground="{StaticResource Text.Primary}"/>
          </StackPanel>
          <TextBlock Grid.Column="1"
                     Text="{Binding RemainingFormatted}"
                     FontFamily="{StaticResource Font.Mono}" FontSize="12"
                     Foreground="{StaticResource Text.Tertiary}"/>
        </Grid>

        <!-- Error banner - only when in failed/cancelled state -->
        <Border Grid.Row="5" Margin="24,12,24,0" Padding="12,10"
                Background="{StaticResource Bg.Surface2}"
                BorderBrush="{StaticResource State.Danger}" BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding IsFailed, Converter={StaticResource Bool2Vis}}">
          <StackPanel>
            <TextBlock Text="Reason" Style="{StaticResource Text.SectionLabel}"
                       Foreground="{StaticResource State.Danger}" FontSize="11"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource Text.Primary}" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Parts list -->
        <Border Grid.Row="6" Margin="24,16,24,0"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0">
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="PARTS" Style="{StaticResource Text.SectionLabel}"
                       Foreground="{StaticResource Text.Tertiary}" FontSize="11"
                       Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Parts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status icon: queued = open circle, in-progress = filled
                         dot, done = check. We swap visibility per state. -->
                    <Ellipse Grid.Column="0" Width="11" Height="11" StrokeThickness="1.5"
                             Stroke="{StaticResource Border.Strong}" Fill="Transparent"
                             Visibility="{Binding IsQueued, Converter={StaticResource Bool2Vis}}"/>
                    <Path Grid.Column="0" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{StaticResource Accent.Base}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fill="Transparent"
                          Data="M 6,1 A 5,5 0 1 1 1,6"
                          RenderTransformOrigin="0.5,0.5"
                          Visibility="{Binding IsInProgress, Converter={StaticResource Bool2Vis}}">
                      <Path.RenderTransform>
                        <RotateTransform Angle="0"/>
                      </Path.RenderTransform>
                      <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                          <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                              <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                From="0" To="360" Duration="0:0:1"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Path.Triggers>
                    </Path>
                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{StaticResource State.Success}" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5,12 L10,17 L19,7"
                          Visibility="{Binding IsDone, Converter={StaticResource Bool2Vis}}"/>
                    <Path Grid.Column="0" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{StaticResource State.Danger}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M6,6 L18,18 M18,6 L6,18"
                          Visibility="{Binding IsFailed, Converter={StaticResource Bool2Vis}}"/>

                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                               Foreground="{StaticResource Text.Primary}" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding TimeRange}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding ElapsedFormatted}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource Text.Secondary}"
                               TextAlignment="Right" MinWidth="56"/>
                    <TextBlock Grid.Column="4" Text="{Binding StatusText}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource Text.Tertiary}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="8" Background="Transparent"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="20,14" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Exporting: Cancel export | Run in background -->
            <Button Grid.Column="0" Style="{StaticResource Button.Danger}" Click="OnCancelExport"
                    Content="Cancel export"
                    Visibility="{Binding IsExporting, Converter={StaticResource Bool2Vis}}"/>
            <Button Grid.Column="2" Click="OnRunInBackground"
                    Content="Run in background"
                    Visibility="{Binding IsExporting, Converter={StaticResource Bool2Vis}}"/>

            <!-- Terminal (completed or failed): Close -->
            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Click="OnCloseTerminal"
                    Content="Close"
                    Visibility="{Binding IsTerminal, Converter={StaticResource Bool2Vis}}"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
