<Window x:Class="AdTrim.Views.EncoderOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export options" Width="620" SizeToContent="Height" MaxHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Font.UI}">
  <Border Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="10">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="36" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Export options" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
        <Button x:Name="TitleCloseButton" Grid.Column="1" Style="{StaticResource DialogCloseButton}" Click="OnTitleClose" ToolTip="Cancel export" AutomationProperties.Name="Cancel export">
          <Path Stroke="{StaticResource Text.Secondary}" StrokeThickness="1" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"/>
        </Button>
      </Grid>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,0,0,14" MaxHeight="100"/>
    <ListBox x:Name="OptionsList" Grid.Row="1" MaxHeight="330" SelectionChanged="OnSelectionChanged"
             Background="{StaticResource Bg.Surface}" BorderThickness="0">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="IsEnabled" Value="{Binding Available}"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="10" Margin="0,3" BorderThickness="1" CornerRadius="4" ToolTip="{Binding Detail}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Fastest}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent.Base}"/>
                    <Setter Property="Background" Value="{StaticResource Bg.Surface2}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
              <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource Text.Secondary}"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="Fastest in this test. Actual export speed varies by video." TextWrapping="Wrap"
               Margin="0,12,0,18" Foreground="{StaticResource Text.Secondary}"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="DismissButton" Content="Close" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="RestartButton" Content="Restart export" IsDefault="True" Click="OnRestart"
              Style="{StaticResource Button.Primary}"/>
    </StackPanel>
  </Grid>
    </DockPanel>
  </Border>
</Window>
