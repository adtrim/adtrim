<Window x:Class="AdTrim.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating AdTrim" Width="560" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="False"
        Icon="pack://application:,,,/icon-512.png"
        FontFamily="{StaticResource Font.UI}" Foreground="{StaticResource Text.Primary}">
  <Border Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="OnDrag">
        <TextBlock Text="AdTrim update" Margin="16,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Margin="28,16,28,24">
          <TextBlock x:Name="Heading" Text="Updating AdTrim" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="Versions" Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
          <TextBlock x:Name="Explanation" Margin="0,16,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                     Text="Your projects and settings were saved. Please keep this window open; your recording windows become usable when the update finishes."/>
          <ItemsControl x:Name="StepList" Margin="0,18,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}" Foreground="{Binding Brush}" FontFamily="Segoe UI Symbol" FontSize="14" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="Status" Margin="0,14,0,0" FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
          <StackPanel x:Name="ErrorPanel" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ErrorTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource State.Danger}" TextWrapping="Wrap"/>
            <TextBox x:Name="ErrorMessage" Margin="0,8,0,0" Padding="0" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                     Background="Transparent" Foreground="{StaticResource Text.Primary}" IsTabStop="False"/>
            <TextBlock x:Name="ErrorHelp" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="20,14">
        <Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="ReportButton" Content="Report a problem" Padding="14,7" Click="OnReport" Visibility="Collapsed"/>
            <Button x:Name="CopyButton" Content="Copy details" Padding="14,7" Margin="10,0,0,0" Click="OnCopy" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StopButton" Content="Stop installer" Padding="14,7" Click="OnStop" Visibility="Collapsed" Style="{StaticResource Button.Warning}"/>
            <Button x:Name="CancelButton" Content="Cancel update" Padding="14,7" Margin="10,0,0,0" Click="OnCancel" Visibility="Collapsed"/>
            <Button x:Name="RetryButton" Content="Retry" Padding="18,7" Margin="10,0,0,0" Click="OnRetry" Visibility="Collapsed" Style="{StaticResource Button.Primary}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
