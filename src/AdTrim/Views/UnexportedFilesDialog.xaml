<Window x:Class="AdTrim.Views.UnexportedFilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Unexported Files" Width="1150" Height="760" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg.Surface}" Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Font.UI}">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="View Unexported Files" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="FolderLabel" TextTrimming="CharacterEllipsis" Margin="0,6,0,6" Foreground="{StaticResource Text.Secondary}"/>
    </StackPanel>
    <TextBlock x:Name="StatusLabel" Grid.Row="1" Margin="0,0,0,10" Text="Scanning..." VerticalAlignment="Center" TextWrapping="Wrap"/>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="275"/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TreeView x:Name="FolderTree" SelectedItemChanged="OnFolderSelected"
                Background="{StaticResource Bg.Surface}" Foreground="{StaticResource Text.Primary}" BorderBrush="{StaticResource Border.Subtle}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <TreeView.Resources>
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Accent.Base.Color}"/>
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Text.Primary.Color}"/>
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Bg.Surface2.Color}"/>
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Text.Primary.Color}"/>
        </TreeView.Resources>
      </TreeView>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                    Background="{StaticResource Border.Subtle}" ResizeBehavior="PreviousAndNext"/>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <DockPanel Margin="8,0,0,6">
          <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="OnRefresh" IsEnabled="False" Margin="12,0,0,0"
                  ToolTip="Refresh this folder and its subfolders"/>
          <TextBlock x:Name="SelectionLabel" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    <ListBox x:Name="FilesList" Grid.Row="1" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Subtle}"
             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <EventSetter Event="MouseDoubleClick" Handler="OnFileDoubleClick"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="8,6">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="{Binding RelativePath}" Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
              <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" FontSize="12">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                  <DataTrigger Binding="{Binding Detail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="Open" IsEnabled="{Binding CanOpen}" Click="OnOpen" Padding="16,5"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
        <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="Scanning..." Foreground="{StaticResource Text.Secondary}"
                   Margin="16" TextWrapping="Wrap" IsHitTestVisible="False"/>
      </Grid>
    </Grid>
    <Button Grid.Row="3" Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="20,6"/>
  </Grid>
</Window>
