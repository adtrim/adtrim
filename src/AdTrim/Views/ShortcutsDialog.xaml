<Window x:Class="AdTrim.Views.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Font.UI}">
  <Border Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="10">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="36" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Keyboard shortcuts" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
        <Button Grid.Column="1" Style="{StaticResource DialogCloseButton}" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close keyboard shortcuts">
          <Path Stroke="{StaticResource Text.Secondary}" StrokeThickness="1" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"/>
        </Button>
      </Grid>
      <StackPanel Margin="20,4,20,20">
        <Grid x:Name="Columns">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel x:Name="LeftColumn"/>
          <StackPanel x:Name="RightColumn" Grid.Column="2"/>
        </Grid>
        <Button Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource Button.Primary}" Click="OnClose"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
