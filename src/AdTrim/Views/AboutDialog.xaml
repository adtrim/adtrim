<Window x:Class="AdTrim.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:AdTrim"
        Title="About AdTrim"
        Width="420" Height="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.UI}">

  <Border Background="{StaticResource Bg.Surface}"
          BorderBrush="{StaticResource Border.Strong}" BorderThickness="1"
          CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="64" ShadowDepth="24" Direction="270"
                        Color="Black" Opacity="0.55"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- Title bar -->
        <RowDefinition Height="*"/>      <!-- Body -->
        <RowDefinition Height="Auto"/>   <!-- Footer -->
      </Grid.RowDefinitions>

      <!-- Title bar (drag area + close) -->
      <Grid Grid.Row="0" Height="36" Background="Transparent"
            MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="About"
                   Margin="16,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
        <Button Grid.Column="1" Style="{StaticResource WindowControlButton.Close}"
                Click="OnClose">
          <Path Stroke="{StaticResource Text.Secondary}" StrokeThickness="1"
                Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"/>
        </Button>
      </Grid>

      <!-- Body -->
      <StackPanel Grid.Row="1" Margin="32,12,32,12" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/icon-512.png"
               Width="64" Height="64"
               HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="AdTrim"
                   FontSize="20" FontWeight="Medium"
                   HorizontalAlignment="Center" Margin="0,12,0,0"
                   Foreground="{StaticResource Text.Primary}"/>
        <TextBlock x:Name="VersionText" Text="{x:Static app:AppVersion.Display}"
                   FontFamily="{StaticResource Font.Mono}" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,4,0,0"
                   Foreground="{StaticResource Text.Tertiary}"/>
        <TextBlock Text="Cut the commercials. Keep the show."
                   TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,16,0,0"
                   Foreground="{StaticResource Text.Primary}"
                   FontSize="14" FontWeight="Medium"/>
        <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,8,0,0" LineHeight="18"
                   Foreground="{StaticResource Text.Secondary}" FontSize="12">
          A frame-accurate, non-destructive editor for trimming ad breaks
          out of recorded TV, for the kind of people who hand-curate a
          media library.
        </TextBlock>
      </StackPanel>

      <!-- Footer -->
      <Border Grid.Row="2" Background="{StaticResource Bg.Surface2}"
              BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
              CornerRadius="0,0,10,10" Padding="16,12">
        <Button Style="{StaticResource Button.Primary}" Padding="18,5"
                HorizontalAlignment="Right" Content="Close" Click="OnClose"/>
      </Border>
    </Grid>
  </Border>
</Window>
