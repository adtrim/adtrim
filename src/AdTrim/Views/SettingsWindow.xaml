<Window x:Class="AdTrim.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="820" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Font.UI}" FontSize="13">
  <Window.Resources>
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="12,9" Margin="0,0,0,2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Surface2}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E2A44"/>
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent.Base}"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Choice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,10,0">
                <Ellipse x:Name="Ring" Stroke="{StaticResource Border.Strong}" StrokeThickness="1.5"/>
                <Ellipse x:Name="Dot" Margin="4" Fill="{StaticResource Accent.Base}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Grid.Column="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent.Base}"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent.Base}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="16,2,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="34" Height="20" Background="Transparent">
              <Border x:Name="Track" Background="{StaticResource Border.Strong}" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent"/>
              <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource Text.Secondary}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent.Base}"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Bg.Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="16,13"/>
    </Style>
    <Style x:Key="Name" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Desc" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="PaneTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PaneLead" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,16"/>
    </Style>
    <Style x:Key="Error" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource State.Warning}"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="Preview" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource State.Success}"/><Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent.Base}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" Background="{StaticResource Bg.Lane}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1" CornerRadius="4">
                      <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="10,0,30,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                <Border Background="{StaticResource Bg.Lane}" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="240"><StackPanel IsItemsHost="True"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1" CornerRadius="10">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="38" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Settings" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
        <Button Grid.Column="1" Style="{StaticResource DialogCloseButton}" Click="OnDone" ToolTip="Close" AutomationProperties.Name="Close settings">
          <Path Stroke="{StaticResource Text.Secondary}" StrokeThickness="1" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"/>
        </Button>
      </Grid>
      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,12">
        <Grid>
          <TextBlock x:Name="FooterNote" Text="Changes apply right away and are shared by every AdTrim window."
                     Foreground="{StaticResource Text.Tertiary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,120,0"/>
          <Button x:Name="DoneButton" Content="Done" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right" Padding="22,8"
                  IsDefault="True" IsCancel="True" Click="OnDone"/>
        </Grid>
      </Border>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Bg.Window}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,0" Padding="8,10">
          <StackPanel x:Name="Navigation" KeyboardNavigation.DirectionalNavigation="Cycle">
            <RadioButton x:Name="NavEditing" Style="{StaticResource NavItem}" GroupName="Nav" Content="Editing" Tag="EditingPane" Checked="OnNavigate" IsChecked="True"/>
            <RadioButton x:Name="NavTimeline" Style="{StaticResource NavItem}" GroupName="Nav" Content="Timeline and playback" Tag="TimelinePane" Checked="OnNavigate"/>
            <RadioButton x:Name="NavExport" Style="{StaticResource NavItem}" GroupName="Nav" Content="Export" Tag="ExportPane" Checked="OnNavigate"/>
            <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" GroupName="Nav" Content="Updates" Tag="UpdatesPane" Checked="OnNavigate"/>
            <RadioButton x:Name="NavStorage" Style="{StaticResource NavItem}" GroupName="Nav" Content="Storage" Tag="StoragePane" Checked="OnNavigate"/>
          </StackPanel>
        </Border>
        <ScrollViewer x:Name="PaneScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="24,20,24,10">

            <!-- Editing -->
            <StackPanel x:Name="EditingPane">
              <TextBlock Text="Editing" Style="{StaticResource PaneTitle}"/>
              <TextBlock Text="How recordings start out, and how parts are named." Style="{StaticResource PaneLead}"/>
              <Border Style="{StaticResource Group}">
                <StackPanel>
                  <Border Style="{StaticResource Row}">
                    <StackPanel>
                      <TextBlock Text="Starting markers for recordings without a project" Style="{StaticResource Name}"/>
                      <StackPanel Margin="0,8,0,0">
                        <RadioButton x:Name="StartImported" Style="{StaticResource Choice}" GroupName="Start" Checked="OnStartingMarkers" Tag="Imported">
                          <StackPanel><TextBlock Text="Imported markers"/><TextBlock Text="Use the chapters already in the recording." Style="{StaticResource Desc}"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="StartAdTrim" Style="{StaticResource Choice}" GroupName="Start" Checked="OnStartingMarkers" Tag="AdTrim">
                          <StackPanel><TextBlock Text="AdTrim suggested markers"/><TextBlock Text="Analyze ad breaks when the recording opens." Style="{StaticResource Desc}"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="StartNone" Style="{StaticResource Choice}" GroupName="Start" Checked="OnStartingMarkers" Tag="None">
                          <StackPanel><TextBlock Text="None"/><TextBlock Text="Start with the whole recording as one part." Style="{StaticResource Desc}"/></StackPanel>
                        </RadioButton>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Row}" BorderThickness="0">
                    <StackPanel>
                      <TextBlock Text="Name for parts you have not named" Style="{StaticResource Name}"/>
                      <TextBlock Text="Write {n} where the number goes. Kept parts are numbered in order, skipping removed parts and parts you named. Used as chapter names." Style="{StaticResource Desc}"/>
                      <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PartNameBox" MaxLength="40" Padding="10,7" TextChanged="OnPartNameChanged" AutomationProperties.Name="Name for parts you have not named"/>
                        <Button Grid.Column="1" Content="Use default" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Click="OnPartNameDefault"/>
                      </Grid>
                      <TextBlock x:Name="PartNamePreview" Style="{StaticResource Preview}"/>
                      <TextBlock x:Name="PartNameError" Style="{StaticResource Error}" Visibility="Collapsed"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Timeline and playback -->
            <StackPanel x:Name="TimelinePane" Visibility="Collapsed">
              <TextBlock Text="Timeline and playback" Style="{StaticResource PaneTitle}"/>
              <TextBlock Text="The display switches are also in the View menu for quick changes. Both places change the same setting." Style="{StaticResource PaneLead}"/>
              <Border Style="{StaticResource Group}">
                <StackPanel>
                  <Border Style="{StaticResource Row}"><DockPanel>
                    <CheckBox x:Name="ThumbnailsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnTimelineSwitch" AutomationProperties.Name="Show thumbnails"/>
                    <StackPanel><TextBlock Text="Show thumbnails" Style="{StaticResource Name}"/><TextBlock Text="Picture strip above the timeline." Style="{StaticResource Desc}"/></StackPanel>
                  </DockPanel></Border>
                  <Border Style="{StaticResource Row}"><DockPanel>
                    <CheckBox x:Name="WaveformSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnTimelineSwitch" AutomationProperties.Name="Show waveform"/>
                    <StackPanel><TextBlock Text="Show waveform" Style="{StaticResource Name}"/><TextBlock Text="Audio levels under the timeline. Reads the whole recording once in the background." Style="{StaticResource Desc}"/></StackPanel>
                  </DockPanel></Border>
                  <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
                    <CheckBox x:Name="RulerSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnTimelineSwitch" AutomationProperties.Name="Show ruler ticks"/>
                    <StackPanel><TextBlock Text="Show ruler ticks" Style="{StaticResource Name}"/><TextBlock Text="Time marks along the ruler." Style="{StaticResource Desc}"/></StackPanel>
                  </DockPanel></Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Group}">
                <StackPanel>
                  <Border Style="{StaticResource Row}"><DockPanel>
                    <CheckBox x:Name="FrameAccurateSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnTimelineSwitch" AutomationProperties.Name="Frame-accurate seeking"/>
                    <StackPanel><TextBlock Text="Frame-accurate seeking" Style="{StaticResource Name}"/><TextBlock Text="Lands exactly on the frame you click. Slower on recordings with long gaps between keyframes." Style="{StaticResource Desc}"/></StackPanel>
                  </DockPanel></Border>
                  <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
                    <CheckBox x:Name="StartMutedSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnTimelineSwitch" AutomationProperties.Name="Start muted"/>
                    <StackPanel><TextBlock Text="Start muted" Style="{StaticResource Name}"/><TextBlock Text="Open AdTrim with the sound off. The mute button still switches it for the session." Style="{StaticResource Desc}"/></StackPanel>
                  </DockPanel></Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Export -->
            <StackPanel x:Name="ExportPane" Visibility="Collapsed">
              <TextBlock Text="Export" Style="{StaticResource PaneTitle}"/>
              <TextBlock Text="Defaults for new exports. Export setup can still change the folder, name, format, acceleration and sidecar deletion for one export; the last format, acceleration and sidecar choice are remembered here." Style="{StaticResource PaneLead}"/>
              <Border Style="{StaticResource Group}">
                <StackPanel>
                  <Border Style="{StaticResource Row}">
                    <StackPanel>
                      <TextBlock Text="Save exports to" Style="{StaticResource Name}"/>
                      <StackPanel Margin="0,8,0,0">
                        <RadioButton x:Name="FolderBeside" Style="{StaticResource Choice}" GroupName="Folder" Content="The recording's folder" Checked="OnFolderChoice"/>
                        <RadioButton x:Name="FolderFixed" Style="{StaticResource Choice}" GroupName="Folder" Content="This folder" Checked="OnFolderChoice"/>
                      </StackPanel>
                      <Grid Margin="26,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ExportFolderBox" Padding="10,7" FontFamily="{StaticResource Font.Mono}" FontSize="12" LostKeyboardFocus="OnExportFolderEdited" AutomationProperties.Name="Export folder"/>
                        <Button x:Name="BrowseFolderButton" Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseFolder"/>
                      </Grid>
                      <TextBlock x:Name="ExportFolderError" Style="{StaticResource Error}" Margin="26,6,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <StackPanel>
                      <TextBlock Text="Filename" Style="{StaticResource Name}"/>
                      <TextBlock Text="{}{title} is the recording's name, {version} the AdTrim version and {date} the day of the export. A number is added if the file exists." Style="{StaticResource Desc}"/>
                      <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FilenameBox" MaxLength="120" Padding="10,7" FontFamily="{StaticResource Font.Mono}" FontSize="12" TextChanged="OnFilenameChanged" AutomationProperties.Name="Export filename pattern"/>
                        <Button Grid.Column="1" Content="Use default" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Click="OnFilenameDefault"/>
                      </Grid>
                      <TextBlock x:Name="FilenamePreview" Style="{StaticResource Preview}"/>
                      <TextBlock x:Name="FilenameError" Style="{StaticResource Error}" Visibility="Collapsed"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <StackPanel>
                      <TextBlock Text="Format" Style="{StaticResource Name}"/>
                      <TextBlock Text="MP4 keeps chapters. TS exports have none." Style="{StaticResource Desc}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="FormatMp4" Style="{StaticResource Choice}" GroupName="Format" Content="MP4 (.mp4)" Checked="OnFormatChoice" Margin="0,4,28,4"/>
                        <RadioButton x:Name="FormatTs" Style="{StaticResource Choice}" GroupName="Format" Content="MPEG transport stream (.ts)" Checked="OnFormatChoice"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Row}" BorderThickness="0">
                    <DockPanel>
                      <ComboBox x:Name="AccelerationSelector" DockPanel.Dock="Right" Width="240" Margin="16,0,0,0" VerticalAlignment="Center"
                                DisplayMemberPath="Name" SelectionChanged="OnAccelerationChoice" AutomationProperties.Name="Export acceleration"/>
                      <StackPanel><TextBlock Text="Acceleration" Style="{StaticResource Name}"/><TextBlock Text="Automatic tests the options when an export starts and uses the fastest." Style="{StaticResource Desc}"/></StackPanel>
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Group}">
                <StackPanel>
                  <Border Style="{StaticResource Row}"><DockPanel>
                    <CheckBox x:Name="SourceCommentSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnExportSwitch" AutomationProperties.Name="Add export comment to the source file"/>
                    <StackPanel><TextBlock Text="Add export comment to the source file" Style="{StaticResource Name}"/>
                      <TextBlock Text="MP4 sources only. After a successful export, adds the AdTrim version and date to the source's Windows Comments. Video, audio and existing comments are kept. On a large recording this copies the file once." Style="{StaticResource Desc}"/></StackPanel>
                  </DockPanel></Border>
                  <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
                    <CheckBox x:Name="DeleteSidecarSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnExportSwitch" AutomationProperties.Name="Delete project sidecar after export"/>
                    <StackPanel><TextBlock Text="Delete project sidecar after export" Style="{StaticResource Name}"/>
                      <TextBlock Text="Only after a successful export. For TS sources this also removes the export record." Style="{StaticResource Desc}"/></StackPanel>
                  </DockPanel></Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Updates -->
            <StackPanel x:Name="UpdatesPane" Visibility="Collapsed">
              <TextBlock Text="Updates" Style="{StaticResource PaneTitle}"/>
              <TextBlock Text="AdTrim checks a signed announcement on adtrim.github.io. Nothing about your recordings is sent." Style="{StaticResource PaneLead}"/>
              <Border Style="{StaticResource Group}">
                <StackPanel>
                  <Border Style="{StaticResource Row}"><DockPanel>
                    <CheckBox x:Name="AutomaticUpdatesSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnAutomaticUpdates" AutomationProperties.Name="Automatically check for updates"/>
                    <StackPanel><TextBlock Text="Automatically check for updates" Style="{StaticResource Name}"/><TextBlock Text="Includes security updates. Turn off to check only when you ask." Style="{StaticResource Desc}"/></StackPanel>
                  </DockPanel></Border>
                  <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
                    <Button x:Name="CheckNowButton" DockPanel.Dock="Right" Content="Check now" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnCheckNow"/>
                    <StackPanel>
                      <TextBlock x:Name="InstalledVersionText" Style="{StaticResource Name}"/>
                      <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Desc}"/>
                    </StackPanel>
                  </DockPanel></Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Storage -->
            <StackPanel x:Name="StoragePane" Visibility="Collapsed">
              <TextBlock Text="Storage" Style="{StaticResource PaneTitle}"/>
              <TextBlock Text="What AdTrim keeps on this computer. Projects are saved beside each recording and are not affected here." Style="{StaticResource PaneLead}"/>
              <Border Style="{StaticResource Group}">
                <StackPanel>
                  <Border Style="{StaticResource Row}"><DockPanel>
                    <Button x:Name="ClearCachesButton" DockPanel.Dock="Right" Content="Clear caches" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnClearCaches"/>
                    <StackPanel><TextBlock Text="Thumbnail and waveform caches" Style="{StaticResource Name}"/>
                      <TextBlock Text="Rebuilt when needed. Caches unused for 90 days are removed automatically." Style="{StaticResource Desc}"/>
                      <TextBlock x:Name="CacheSizeText" Style="{StaticResource Desc}" FontFamily="{StaticResource Font.Mono}" Margin="0,6,0,0"/></StackPanel>
                  </DockPanel></Border>
                  <Border Style="{StaticResource Row}"><DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open folder" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnOpenDataFolder"/>
                    <StackPanel><TextBlock Text="AdTrim data folder" Style="{StaticResource Name}"/>
                      <TextBlock Text="Settings, caches, the crash log, and projects saved here when a recording's folder is read-only." Style="{StaticResource Desc}"/></StackPanel>
                  </DockPanel></Border>
                  <Border Style="{StaticResource Row}" BorderThickness="0"><DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reset…" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnResetAll"/>
                    <StackPanel><TextBlock Text="Reset all settings" Style="{StaticResource Name}"/>
                      <TextBlock Text="Returns every setting in this window to its default and keeps a copy of the old settings file. Projects, recordings and window positions are not changed." Style="{StaticResource Desc}"/></StackPanel>
                  </DockPanel></Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
