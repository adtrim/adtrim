<UserControl x:Class="AdTrim.Views.EmptyStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg.Window}">

  <Grid>
    <!-- WPF `Border` only supports solid edges. To draw a dashed rounded
         border, layer a `Rectangle` (with the gradient fill + dashed stroke)
         underneath the content `StackPanel`. -->
    <Grid MaxWidth="880" Height="600" Margin="40">
      <Rectangle RadiusX="12" RadiusY="12"
                 Stroke="{StaticResource Border.Strong}" StrokeThickness="2"
                 StrokeDashArray="4 4" StrokeDashCap="Round"
                 SnapsToDevicePixels="True">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Color="#0A4F8CFF" Offset="0"/>
            <GradientStop Color="Transparent" Offset="0.7"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">

        <!-- App-logo tile. The PNG already has its own dark rounded backdrop,
             so we render it edge-to-edge inside the 88×88 frame (no inner
             padding) and skip the placeholder Border styling that the
             original abstract glyph needed. -->
        <Image Source="pack://application:,,,/icon-512.png"
               Width="88" Height="88"
               HorizontalAlignment="Center" Margin="0,0,0,18"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <TextBlock Text="Drop an MP4 to start editing"
                   Style="{StaticResource Text.DropCta}"
                   HorizontalAlignment="Center"/>

        <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}" FontSize="14"
                   Margin="0,8,0,18">
          AdTrim reads chapter markers embedded by ComSkip and lets you refine commercial breaks, then exports a clean merged MP4.
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Style="{StaticResource Button.Primary}" Padding="14,8" Click="OnOpenClicked">
            <StackPanel Orientation="Horizontal">
              <Path Width="14" Height="14" Stretch="Uniform"
                    Fill="Transparent" Stroke="White" StrokeThickness="1.6"
                    Data="M3,7 L6,4 L10,4 L12,6 L21,6 L21,18 L3,18 Z"
                    Margin="0,0,6,0"/>
              <TextBlock Text="Open file…" Foreground="White"/>
            </StackPanel>
          </Button>
          <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Text.Tertiary}" FontSize="12">
            or tap
            <Run FontFamily="{StaticResource Font.Mono}" Background="{StaticResource Bg.Surface2}"
                 Foreground="{StaticResource Text.Secondary}" Text=" Ctrl + O "/>
          </TextBlock>
        </StackPanel>

        <!-- Tip -->
        <Border Margin="0,24,0,0" HorizontalAlignment="Center"
                Background="{StaticResource Bg.Surface2}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                CornerRadius="6" Padding="14,10">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="{StaticResource Text.Tertiary}" Margin="0,0,8,0"/>
            <TextBlock Foreground="{StaticResource Text.Tertiary}" FontSize="12"
                       Text="Tip: right-click an MP4 in Explorer and choose &quot;Edit with AdTrim&quot;"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
