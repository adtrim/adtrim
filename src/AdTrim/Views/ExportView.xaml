<UserControl x:Class="AdTrim.Views.ExportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AdTrim.Converters"
        xmlns:vm="clr-namespace:AdTrim.ViewModels"
        Focusable="True"
        Background="{StaticResource Bg.Window}"
        FontFamily="{StaticResource Font.UI}">

  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
    <conv:ProgressRingConverter x:Key="ProgressRing"/>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border Grid.Column="1" Background="{StaticResource Accent.Base}" CornerRadius="3" Padding="6,2" Margin="0,0,10,0"
                        Visibility="{Binding IsFastest, Converter={StaticResource Bool2Vis}}">
                  <TextBlock Text="FASTEST" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding TimingLabel}" MinWidth="52" TextAlignment="Right"
                           FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsFastest}" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#304F8CFF"/>
              </DataTrigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent.Base}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" Background="{StaticResource Bg.Lane}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border.Strong}"
                            BorderThickness="1" CornerRadius="4">
                      <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Text.Secondary}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                         Margin="10,8,30,8" IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                <Border Background="{StaticResource Bg.Lane}" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="240"><StackPanel IsItemsHost="True"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ExportSection" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Bg.Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="ExportSectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <conv:TimeFormatConverter x:Key="TimeFmt"/>
    <conv:StatusKindToBrushConverter x:Key="StatusKindBrush"/>
    <conv:StatusKindToBannerBgConverter x:Key="StatusKindBannerBg"/>
    <conv:BoolToCollapsedConverter x:Key="Bool2Collapse"/>
    <conv:ProgressTrackWidthConverter x:Key="ProgressTrackWidth"/>
    <Style x:Key="SettingRow" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="18,14"/>
    </Style>
    <Style x:Key="SettingLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,11,16,0"/>
      <Setter Property="VerticalAlignment" Value="Top"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PaneCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Bg.Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="SmallCaps" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionLabel}">
      <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/><Setter Property="FontSize" Value="11"/>
    </Style>
  </UserControl.Resources>

  <!-- Two panes for the whole export: the settings, then the progress, on the left; the job
       (durations, every part and every step after them) on the right, in both states. -->
  <Grid x:Name="ExportLayout" Margin="28,20" MaxWidth="1640" HorizontalAlignment="Stretch"
        TextElement.Foreground="{StaticResource Text.Primary}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SettingsColumn" Width="3*" MinWidth="540" MaxWidth="820"/>
      <ColumnDefinition Width="24"/>
      <ColumnDefinition x:Name="ProgressDetailsColumn" Width="2*" MinWidth="420" MaxWidth="720"/>
    </Grid.ColumnDefinitions>

    <!-- ====================================================== -->
    <!-- SETUP: left pane                                        -->
    <!-- ====================================================== -->
    <Grid x:Name="ConfigPanel" Visibility="{Binding IsConfiguring, Converter={StaticResource Bool2Vis}}" VerticalAlignment="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="ConfigScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
          <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SourceDisplayName}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding SourceSubtitle}" Foreground="{StaticResource Text.Secondary}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SourceSubtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Border Style="{StaticResource PaneCard}" Margin="0,16,0,0">
            <StackPanel x:Name="ExportSettingsCards">
              <Border x:Name="FormatCard" Style="{StaticResource SettingRow}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="File format" Style="{StaticResource SettingLabel}"/>
                  <StackPanel Grid.Column="1">
                    <ComboBox x:Name="FormatSelector" MinHeight="40" AutomationProperties.Name="Export file format" Tag="{Binding FormatLabel}" ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}" SelectionChanged="OnFormatChanged" IsEnabled="{Binding CanCheckHardware}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock>
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="MP4 (.mp4)"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding}" Value="Ts">
                                    <Setter Property="Text" Value="MPEG transport stream (.ts)"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                      <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                          <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        </Style>
                      </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Text="Chapter markers and names are included. Your last choice is remembered." Foreground="{StaticResource State.Success}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding IsTsExport, Converter={StaticResource Bool2Collapse}}"/>
                    <Border x:Name="TsChapterBanner" Background="{StaticResource State.WarningTint}" BorderBrush="{StaticResource State.Warning}" BorderThickness="3,0,0,0" CornerRadius="4" Padding="14,12" Margin="0,10,0,0" Visibility="{Binding IsTsExport, Converter={StaticResource Bool2Vis}}">
                      <StackPanel>
                        <TextBlock Text="No chapters in TS exports" Foreground="{StaticResource State.Warning}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TsChapterNotice" Text="TS exports do not include chapter markers or chapter names. Choose MP4 to keep chapters." Visibility="{Binding IsTsExport, Converter={StaticResource Bool2Vis}}" Foreground="{StaticResource Text.Primary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="DestinationCard" Style="{StaticResource SettingRow}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="Output folder" Style="{StaticResource SettingLabel}"/>
                  <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputFolderInput" Padding="12,9" MinHeight="40" FontFamily="{StaticResource Font.Mono}" FontSize="13" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output folder"/>
                    <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseFolder"/>
                  </Grid>
                  <StackPanel Grid.Row="1" Margin="0,14,16,0">
                    <TextBlock Text="Output filename" Style="{StaticResource SettingLabel}" Margin="0,11,0,0"/>
                    <TextBlock Text="{Binding ExtensionHint}" Foreground="{StaticResource Text.Tertiary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  </StackPanel>
                  <TextBox x:Name="OutputFilenameInput" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" Padding="12,9" MinHeight="40" VerticalAlignment="Top" FontFamily="{StaticResource Font.Mono}" Text="{Binding OutputFilename, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output filename"/>
                </Grid>
              </Border>
              <Border x:Name="AccelerationCard" Style="{StaticResource SettingRow}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Acceleration" Style="{StaticResource SettingLabel}"/>
                  <StackPanel Grid.Column="1">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ComboBox x:Name="AccelerationSelector" AutomationProperties.Name="Export acceleration" Tag="{Binding AccelerationLabel}" ItemsSource="{Binding AccelerationOptions}" SelectedItem="{Binding SelectedAcceleration}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanCheckHardware}" Height="{Binding ActualHeight, ElementName=OutputFilenameInput}"/>
                      <Button Grid.Column="1" Content="Evaluate options" Click="OnRecheckHardware" Margin="6,0,0,0" IsEnabled="{Binding CanCheckHardware}" Height="{Binding ActualHeight, ElementName=OutputFilenameInput}"/>
                      <Button x:Name="EvaluationResultsButton" Grid.Column="2" Content="Results" Click="OnShowEvaluation" Margin="6,0,0,0" IsEnabled="{Binding CanOpenResults}" Height="{Binding ActualHeight, ElementName=OutputFilenameInput}"/>
                    </Grid>
                    <TextBlock Text="{Binding EncoderDescription}" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="AfterExportCard" Style="{StaticResource SettingRow}" BorderThickness="0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="After export" Style="{StaticResource SettingLabel}" Margin="0,7,16,0"/>
                  <StackPanel Grid.Column="1">
                    <CheckBox x:Name="DeleteSidecarCheckBox" Margin="0" IsChecked="{Binding DeleteSidecarAfterExport, Mode=TwoWay}"
                              Checked="OnDeleteSidecarChanged" Unchecked="OnDeleteSidecarChanged"
                              AutomationProperties.Name="Delete project sidecar after successful export" ToolTip="{Binding SidecarDeletionHint}">
                      <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                          <Border x:Name="Card" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="2,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="Delete project sidecar" Foreground="{StaticResource Text.Primary}" FontSize="13" VerticalAlignment="Center"/>
                              <Grid Grid.Column="1" Width="34" Height="20" Margin="16,0,0,0">
                                <Border x:Name="Track" Background="{StaticResource Border.Strong}" CornerRadius="10"/>
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource Text.Secondary}"/>
                              </Grid>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent.Base}"/>
                              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                              <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent.Base}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                              <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent.Base}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </CheckBox.Template>
                    </CheckBox>
                    <TextBlock x:Name="SidecarDeletionNotice" Text="{Binding SidecarDeletionHint}" Foreground="{StaticResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="2,4,2,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding ValidationIssues}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{Binding Kind, Converter={StaticResource StatusKindBannerBg}}" BorderBrush="{Binding Kind, Converter={StaticResource StatusKindBrush}}" BorderThickness="3,0,0,0" CornerRadius="4" Padding="14,12" Margin="0,0,0,8">
                  <TextBlock Text="{Binding Message}" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="ConfigFooter" Grid.Row="1" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,14,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Back to editing" Click="OnCancel"/>
          <Button x:Name="StartExportButton" Grid.Column="2" Style="{StaticResource Button.Primary}" Click="OnExport" IsEnabled="{Binding CanCheckHardware}" Padding="22,10" MinWidth="130">
            <StackPanel Orientation="Horizontal">
              <Path Width="13" Height="13" Stretch="Uniform" Stroke="White" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20" Margin="0,0,6,0"/>
              <TextBlock Text="{Binding ExportButtonText}" Foreground="White"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- ====================================================== -->
    <!-- PROGRESS: left pane                                     -->
    <!-- ====================================================== -->
    <Grid x:Name="ProgressMainPanel" Visibility="{Binding IsConfiguring, Converter={StaticResource Bool2Collapse}}">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ProgressSummary" Margin="0,0,4,0">
          <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SourceDisplayName}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"
                     MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceDisplayName}"/>
          <TextBlock Text="{Binding SourceSubtitle}" Foreground="{StaticResource Text.Secondary}" FontSize="13" TextTrimming="CharacterEllipsis"
                     Margin="0,3,0,0" ToolTip="{Binding SourceSubtitle}">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SourceSubtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Border Style="{StaticResource PaneCard}" Margin="0,16,0,0" Padding="22,20">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Viewbox Width="140" Height="140" VerticalAlignment="Center">
                <Grid Width="184" Height="184" AutomationProperties.Name="Overall export progress">
                  <Ellipse Stroke="{StaticResource Bg.Lane}" StrokeThickness="8" Margin="4"/>
                  <Path x:Name="ProgressDial" Data="{Binding ProgressDialValue, Converter={StaticResource ProgressRing}}"
                        Stroke="{StaticResource Accent.Base}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.RenderTransform><RotateTransform CenterX="92" CenterY="92"/></Path.RenderTransform>
                    <Path.Style>
                      <Style TargetType="Path">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="True">
                            <DataTrigger.EnterActions>
                              <BeginStoryboard x:Name="ActivitySpin">
                                <Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                  From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/></Storyboard>
                              </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ActivitySpin"/></DataTrigger.ExitActions>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Path.Style>
                  </Path>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ProgressPercentText}" FontSize="48" FontWeight="Medium" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ProgressCaption}" Foreground="{StaticResource Text.Secondary}" FontSize="15" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Viewbox>
              <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TimeHeadline" Text="{Binding TimeHeadline}" Foreground="{StaticResource Text.Primary}" FontSize="20" FontWeight="Medium" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ElapsedFormatted, StringFormat=Elapsed {0}}" Foreground="{StaticResource Text.Secondary}" Margin="0,5,0,0"/>
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsExporting, Converter={StaticResource Bool2Vis}}">
                  <TextBlock Text="{Binding CurrentPartHeading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="EncodingProgressLine" Text="{Binding ProgressLine}" Foreground="{StaticResource Text.Secondary}"
                             FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource PaneCard}" Margin="0,12,0,0" Padding="18,14">
            <Grid x:Name="ExportDestinationDetails">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="SAVING TO" Style="{StaticResource SmallCaps}" Margin="0,0,18,6" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OutputFolder}" ToolTip="{Binding OutputFolder}"
                         FontFamily="{StaticResource Font.Mono}" FontSize="13" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Row="1" Text="FILENAME" Style="{StaticResource SmallCaps}" Margin="0,0,18,6" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutputFilename}" ToolTip="{Binding OutputFilename}"
                         FontFamily="{StaticResource Font.Mono}" FontSize="13" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Row="2" Text="ENCODER" Style="{StaticResource SmallCaps}" Margin="0,0,18,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="ExportMethodValue" Grid.Row="2" Grid.Column="1"
                         Text="{Binding ExportMethodLabel}" ToolTip="{Binding ActiveEncoder}"
                         FontFamily="{StaticResource Font.Mono}" FontSize="13" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>
          <TextBlock x:Name="CleanupWarningText" Text="{Binding CleanupWarning}" Foreground="{StaticResource State.Warning}" TextWrapping="Wrap" Margin="0,12,0,0">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
              <DataTrigger Binding="{Binding CleanupWarning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Border x:Name="ProgressError" Margin="0,12,0,0" Padding="14,12"
                  Background="{StaticResource Bg.Surface2}" BorderBrush="{StaticResource State.Danger}" BorderThickness="3,0,0,0" CornerRadius="4"
                  Visibility="{Binding IsFailed, Converter={StaticResource Bool2Vis}}">
            <StackPanel>
              <TextBlock Text="Reason" Style="{StaticResource Text.SectionLabel}" Foreground="{StaticResource State.Danger}" FontSize="11"/>
              <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding ErrorMessage}" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding SourceCommentNote}" TextWrapping="Wrap" Foreground="{StaticResource Text.Secondary}" Margin="0,12,0,0"
                     Visibility="{Binding IsCompleted, Converter={StaticResource Bool2Vis}}"/>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="ProgressFooter" Grid.Row="1" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,14,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource Button.Danger}" Click="OnCancelExport" Content="Cancel export"
                  Visibility="{Binding IsExporting, Converter={StaticResource Bool2Vis}}"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="Open video" Click="OnOpenVideo" Margin="0,0,8,0" Visibility="{Binding IsCompleted, Converter={StaticResource Bool2Vis}}"/>
            <Button Content="Open folder" Click="OnOpenFolder" Margin="0,0,8,0" Visibility="{Binding IsCompleted, Converter={StaticResource Bool2Vis}}"/>
            <Button Style="{StaticResource Button.Primary}" Click="OnCloseTerminal" Content="Back to editing"
                    Visibility="{Binding IsTerminal, Converter={StaticResource Bool2Vis}}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ====================================================== -->
    <!-- RIGHT PANE: the job, in both states                     -->
    <!-- ====================================================== -->
    <Border x:Name="ProgressDetails" Grid.Column="2" Padding="20,18">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource PaneCard}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ShowEvaluation}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ProgressDetailsTitle" Text="{Binding JobTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="PartsSummaryText" Grid.Column="1" Text="{Binding PartsSummary}" Foreground="{StaticResource Text.Secondary}"
                     FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
        <Border Grid.Row="1" Margin="0,14,0,8" Background="{StaticResource Bg.Window}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="14,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="ORIGINAL" Style="{StaticResource SmallCaps}"/>
              <TextBox Style="{StaticResource SelectableText}" Text="{Binding SourceDurationUs, Converter={StaticResource TimeFmt}, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontSize="17" FontWeight="Medium" Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
            </StackPanel>
            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Border.Subtle}" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="2">
              <TextBlock Text="EXCLUDED" Style="{StaticResource SmallCaps}"/>
              <TextBox Style="{StaticResource SelectableText}" FontFamily="{StaticResource Font.Mono}" FontSize="17" FontWeight="Medium" Foreground="{StaticResource State.Warning}" Margin="0,2,0,0" Text="{Binding ExcludedDurationUs, Converter={StaticResource TimeFmt}, StringFormat=−{0}, Mode=OneWay}"/>
            </StackPanel>
            <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Border.Subtle}" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="4">
              <TextBlock Text="EXPORTED" Style="{StaticResource SmallCaps}"/>
              <TextBox Style="{StaticResource SelectableText}" Text="{Binding FinalDurationUs, Converter={StaticResource TimeFmt}, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontSize="17" FontWeight="Medium" Foreground="{StaticResource State.Success}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding FallbackNotice}" Foreground="{StaticResource State.Warning}" TextWrapping="Wrap" Margin="0,0,0,8">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding FallbackNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ScrollViewer x:Name="PartsScrollViewer" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,8,0">
            <!-- Before export: the plan. Same row shape as the progress rows below; the number becomes a check. -->
            <StackPanel Visibility="{Binding IsConfiguring, Converter={StaticResource Bool2Vis}}">
              <ItemsControl x:Name="PlannedPartsList" ItemsSource="{Binding PlannedParts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,5">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.RowSpan="2" Text="{Binding Number}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                 Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"
                                 FontWeight="Medium" VerticalAlignment="Center" Margin="8,0,20,0"/>
                      <TextBlock Grid.Column="2" Text="{Binding TimeRange}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                 Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Length}" ToolTip="Length of this part" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="12" Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl x:Name="PlannedStepsList" ItemsSource="{Binding PlannedSteps}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Ellipse Width="5" Height="5" Fill="{StaticResource Text.Tertiary}" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding}" FontWeight="Medium" Foreground="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- During and after export: the same rows, with status. -->
            <ItemsControl x:Name="ExportPartsList" ItemsSource="{Binding Parts}" Visibility="{Binding IsConfiguring, Converter={StaticResource Bool2Collapse}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,5">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status icon: queued = open circle, in-progress = spinning arc, done = check, failed = cross. -->
                    <Ellipse Grid.Column="0" Grid.RowSpan="2" Width="11" Height="11" StrokeThickness="1.5" HorizontalAlignment="Left"
                             Stroke="{StaticResource Border.Strong}" Fill="Transparent"
                             Visibility="{Binding IsQueued, Converter={StaticResource Bool2Vis}}"/>
                    <Path Grid.Column="0" Grid.RowSpan="2" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Left"
                          Stroke="{StaticResource Accent.Base}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fill="Transparent"
                          Data="M 6,1 A 5,5 0 1 1 1,6"
                          RenderTransformOrigin="0.5,0.5"
                          Visibility="{Binding IsInProgress, Converter={StaticResource Bool2Vis}}">
                      <Path.RenderTransform>
                        <RotateTransform Angle="0"/>
                      </Path.RenderTransform>
                      <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                          <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                              <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                From="0" To="360" Duration="0:0:1"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Path.Triggers>
                    </Path>
                    <Path Grid.Column="0" Grid.RowSpan="2" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left"
                          Stroke="{StaticResource State.Success}" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5,12 L10,17 L19,7"
                          Visibility="{Binding IsDone, Converter={StaticResource Bool2Vis}}"/>
                    <Path Grid.Column="0" Grid.RowSpan="2" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Left"
                          Stroke="{StaticResource State.Danger}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M6,6 L18,18 M18,6 L6,18"
                          Visibility="{Binding IsFailed, Converter={StaticResource Bool2Vis}}"/>

                    <TextBlock x:Name="PartName" Grid.Column="1" Grid.RowSpan="2" Text="{Binding Label}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"
                               FontWeight="Medium" VerticalAlignment="Center" Margin="8,0,20,0"/>
                    <TextBlock x:Name="PartRange" Grid.Column="2" Text="{Binding TimeRange}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Right"
                               ToolTip="{Binding TimeRange}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                      <TextBlock Text="{Binding ElapsedFormatted}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                 Foreground="{StaticResource Text.Secondary}"/>
                      <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                 Foreground="{StaticResource Text.Tertiary}" Margin="12,0,0,0"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- Encoder evaluation results take the right pane's place while open. -->
    <Border Grid.Column="2" Style="{StaticResource PaneCard}" Padding="20,18"
            Visibility="{Binding ShowEvaluation, Converter={StaticResource Bool2Vis}}">
      <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="Hide results" Click="OnHideEvaluation" Margin="0,14,0,0" HorizontalAlignment="Left"/>
        <TextBlock DockPanel.Dock="Top" Text="Evaluation results" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <Border x:Name="FastestCard" DockPanel.Dock="Top" Background="#304F8CFF" BorderBrush="{StaticResource Accent.Base}"
                BorderThickness="2" CornerRadius="6" Padding="12" Margin="0,0,0,18"
                Visibility="{Binding HasFastest, Converter={StaticResource Bool2Vis}}">
          <StackPanel>
            <TextBlock Text="FASTEST IN THIS TEST" Foreground="{StaticResource Accent.Base}" FontWeight="Bold" FontSize="12"/>
            <TextBlock Text="{Binding FastestResult}" Foreground="White" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <TextBox x:Name="EvaluationOutput" Text="{Binding EvaluationReport, Mode=OneWay}"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 Foreground="{StaticResource Text.Secondary}" FontSize="13">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
