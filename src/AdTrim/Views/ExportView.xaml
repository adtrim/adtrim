<UserControl x:Class="AdTrim.Views.ExportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AdTrim.Converters"
        xmlns:vm="clr-namespace:AdTrim.ViewModels"
        Focusable="True"
        Background="{StaticResource Bg.Window}"
        FontFamily="{StaticResource Font.UI}">

  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
    <conv:ProgressRingConverter x:Key="ProgressRing"/>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border Grid.Column="1" Background="{StaticResource Accent.Base}" CornerRadius="3" Padding="6,2" Margin="0,0,10,0"
                        Visibility="{Binding IsFastest, Converter={StaticResource Bool2Vis}}">
                  <TextBlock Text="FASTEST" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding TimingLabel}" MinWidth="52" TextAlignment="Right"
                           FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsFastest}" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#304F8CFF"/>
              </DataTrigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent.Base}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" Background="{StaticResource Bg.Lane}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border.Strong}"
                            BorderThickness="1" CornerRadius="4">
                      <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Text.Secondary}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <TextBlock Text="{Binding DataContext.AccelerationLabel, RelativeSource={RelativeSource TemplatedParent}}"
                         Margin="10,8,30,8" IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                <Border Background="{StaticResource Bg.Lane}" BorderBrush="{StaticResource Border.Strong}" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="240"><StackPanel IsItemsHost="True"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <conv:TimeFormatConverter x:Key="TimeFmt"/>
    <conv:StatusKindToBrushConverter x:Key="StatusKindBrush"/>
    <conv:StatusKindToBannerBgConverter x:Key="StatusKindBannerBg"/>
    <conv:BoolToCollapsedConverter x:Key="Bool2Collapse"/>
    <conv:ProgressTrackWidthConverter x:Key="ProgressTrackWidth"/>
  </UserControl.Resources>

  <Grid Margin="28,20" MaxWidth="1360" HorizontalAlignment="Stretch">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="1" Width="380" Margin="24,0,0,0" Padding="18"
              Background="{StaticResource Bg.Surface2}" CornerRadius="6"
              Visibility="{Binding ShowEvaluation, Converter={StaticResource Bool2Vis}}">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="Hide results" Click="OnHideEvaluation" Margin="0,14,0,0"/>
          <TextBlock DockPanel.Dock="Top" Text="Evaluation results" FontSize="18" FontWeight="SemiBold"
                     Foreground="{StaticResource Text.Primary}" Margin="0,0,0,18"/>
          <Border x:Name="FastestCard" DockPanel.Dock="Top" Background="#304F8CFF" BorderBrush="{StaticResource Accent.Base}"
                  BorderThickness="2" CornerRadius="6" Padding="12" Margin="0,0,0,18"
                  Visibility="{Binding HasFastest, Converter={StaticResource Bool2Vis}}">
            <StackPanel>
              <TextBlock Text="FASTEST IN THIS TEST" Foreground="{StaticResource Accent.Base}" FontWeight="Bold" FontSize="12"/>
              <TextBlock Text="{Binding FastestResult}" Foreground="White" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <TextBox x:Name="EvaluationOutput" Text="{Binding EvaluationReport, Mode=OneWay}"
                   IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   Foreground="{StaticResource Text.Secondary}" FontSize="13">
            <TextBox.Template>
              <ControlTemplate TargetType="TextBox">
                <ScrollViewer x:Name="PART_ContentHost"/>
              </ControlTemplate>
            </TextBox.Template>
          </TextBox>
        </DockPanel>
      </Border>
      <!-- ====================================================== -->
      <!-- CONFIGURING VIEW                                        -->
      <!-- ====================================================== -->
      <Grid Visibility="{Binding IsConfiguring, Converter={StaticResource Bool2Vis}}" MaxWidth="820" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>   <!-- Header -->
          <RowDefinition Height="Auto"/>   <!-- Summary stats -->
          <RowDefinition Height="Auto"/>   <!-- Output folder -->
          <RowDefinition Height="Auto"/>   <!-- Output filename -->
          <RowDefinition Height="Auto"/>   <!-- Post-export options -->
          <RowDefinition Height="Auto"/>   <!-- Warning banner -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0">
          <TextBlock Text="Export merged MP4" Style="{StaticResource Text.DialogTitle}"/>
          <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="13" Margin="0,4,0,0"
                     TextWrapping="Wrap">
            Excluded segments will be cut and the remaining parts merged into a single file.
          </TextBlock>
        </StackPanel>

        <!-- Duration summary -->
        <Border Grid.Row="1" Margin="24,20,24,0"
                Background="{StaticResource Bg.Surface2}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                CornerRadius="6" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="SOURCE" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBox Style="{StaticResource SelectableText}"
                       Text="{Binding SourceDurationUs, Converter={StaticResource TimeFmt}, Mode=OneWay}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                       Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Border.Subtle}" Margin="0,0,14,0"/>

            <StackPanel Grid.Column="2">
              <TextBlock Text="EXCLUDED" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBox Style="{StaticResource SelectableText}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                       Foreground="{StaticResource State.Warning}" Margin="0,2,0,0"
                       Text="{Binding ExcludedDurationUs, Converter={StaticResource TimeFmt}, StringFormat=−{0}, Mode=OneWay}"/>
            </StackPanel>

            <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Border.Subtle}" Margin="0,0,14,0"/>

            <StackPanel Grid.Column="4">
              <TextBlock Text="FINAL" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBox Style="{StaticResource SelectableText}"
                       Text="{Binding FinalDurationUs, Converter={StaticResource TimeFmt}, Mode=OneWay}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                       Foreground="{StaticResource State.Success}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Output folder -->
        <StackPanel Grid.Row="2" Margin="24,20,24,0">
          <TextBlock Text="Output folder" Style="{StaticResource DialogFieldLabel}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     FontFamily="{StaticResource Font.Mono}" FontSize="13"
                     Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseFolder"/>
          </Grid>
        </StackPanel>

        <!-- Output filename -->
        <StackPanel Grid.Row="3" Margin="24,14,24,0">
          <Grid Margin="0,0,0,6">
            <TextBlock Text="Output filename" Style="{StaticResource DialogFieldLabel}" Margin="0"/>
            <TextBlock Text=".mp4 added automatically" HorizontalAlignment="Right"
                       Foreground="{StaticResource Text.Tertiary}" FontSize="12"/>
          </Grid>
          <TextBox x:Name="OutputFilenameInput" FontFamily="{StaticResource Font.Mono}"
                   Text="{Binding OutputFilename, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Export options -->
        <StackPanel Grid.Row="4" Margin="24,14,24,0">
          <TextBlock Text="Export acceleration" Style="{StaticResource DialogFieldLabel}"/>
          <DockPanel Margin="0,0,0,6" Height="{Binding ActualHeight, ElementName=OutputFilenameInput}">
            <Button x:Name="EvaluationResultsButton" DockPanel.Dock="Right" Content="Results" Click="OnShowEvaluation" Margin="6,0,0,0"
                    IsEnabled="{Binding CanOpenResults}"/>
            <Button DockPanel.Dock="Right" Content="Evaluate options" Click="OnRecheckHardware" Margin="6,0,0,0"
                    IsEnabled="{Binding CanCheckHardware}"/>
            <ComboBox x:Name="AccelerationSelector" ItemsSource="{Binding AccelerationOptions}" SelectedItem="{Binding SelectedAcceleration}"
                      DisplayMemberPath="DisplayName" IsEnabled="{Binding CanCheckHardware}"/>
          </DockPanel>
          <TextBlock Text="{Binding EncoderDescription}" Foreground="{StaticResource Text.Secondary}"
                     TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
          <CheckBox x:Name="DeleteSidecarCheckBox" Margin="0,15,0,0" IsChecked="{Binding DeleteSidecarAfterExport, Mode=TwoWay}"
                    AutomationProperties.Name="Delete project sidecar after successful export">
            <CheckBox.Template>
              <ControlTemplate TargetType="CheckBox">
                <Border x:Name="Card" Background="{StaticResource Bg.Surface2}" BorderBrush="{StaticResource Border.Strong}"
                        BorderThickness="1" CornerRadius="7" Padding="14,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Delete project sidecar" Foreground="{StaticResource Text.Primary}" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock Text="Only after a successful export (.adt.json)" Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="34" Height="20" Margin="16,0,0,0">
                      <Border x:Name="Track" Background="{StaticResource Border.Strong}" CornerRadius="10"/>
                      <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource Text.Secondary}"/>
                    </Grid>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent.Base}"/>
                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent.Base}"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent.Base}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </CheckBox.Template>
          </CheckBox>
        </StackPanel>

        <!-- Inline validation banner - one row per issue, kind-colored.        -->
        <!-- Empty collection collapses the row. ScrollViewer caps growth so    -->
        <!-- adding/removing issues doesn't resize the (fixed-height) window -  -->
        <!-- previously this row + SizeToContent="Height" produced visible      -->
        <!-- flicker as validation churned during typing.                        -->
        <ScrollViewer Grid.Row="5" Margin="24,14,24,0" MaxHeight="140"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding ValidationIssues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{Binding Kind, Converter={StaticResource StatusKindBannerBg}}"
                      BorderBrush="{Binding Kind, Converter={StaticResource StatusKindBrush}}"
                      BorderThickness="0,0,0,0"
                      CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <Path Width="14" Height="14" Stretch="Uniform" Margin="0,1,10,0"
                        Stroke="{Binding Kind, Converter={StaticResource StatusKindBrush}}"
                        StrokeThickness="1.6"
                        Fill="Transparent" StrokeLineJoin="Round"
                        Data="M12,4 L21,20 L3,20 Z M12,10 L12,14 M12,17 L12,17"/>
                  <TextBlock Text="{Binding Message}" VerticalAlignment="Center"
                             Foreground="{StaticResource Text.Primary}"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>

        </Grid>
        </ScrollViewer>
        <!-- Actions stay visible while configuration scrolls. -->
        <Border x:Name="ConfigFooter" Grid.Row="1" Background="Transparent"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="20,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Back to editing" Click="OnCancel"/>
            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Click="OnExport"
                    IsEnabled="{Binding CanCheckHardware}"
                    Padding="14,8">
              <StackPanel Orientation="Horizontal">
                <Path Width="13" Height="13" Stretch="Uniform"
                      Stroke="White" StrokeThickness="1.6" Fill="Transparent"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20"
                      Margin="0,0,6,0"/>
                <TextBlock Text="{Binding ExportButtonText}" Foreground="White"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Grid>

      <Grid TextElement.Foreground="{StaticResource Text.Primary}" Visibility="{Binding IsConfiguring, Converter={StaticResource Bool2Collapse}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition x:Name="ProgressDetailsColumn" Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="ProgressMainPanel">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

        <StackPanel x:Name="ProgressSummary" Grid.Row="0" Margin="28,24,28,0">
          <TextBlock Text="{Binding ProgressHeading}" HorizontalAlignment="Center"
                     Foreground="{StaticResource Text.Secondary}" FontSize="11" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SourceDisplayName}" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="24" FontWeight="SemiBold" Margin="0,10,0,5" MaxHeight="64"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceDisplayName}"/>
          <TextBlock Text="{Binding SourceSubtitle}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource Text.Secondary}" FontSize="13" ToolTip="{Binding SourceSubtitle}"/>
          <Grid Width="184" Height="184" Margin="0,28,0,24" HorizontalAlignment="Center"
                AutomationProperties.Name="Overall export progress">
            <Ellipse Stroke="{StaticResource Bg.Lane}" StrokeThickness="8" Margin="4"/>
            <Path x:Name="ProgressDial" Data="{Binding ProgressPercent, Converter={StaticResource ProgressRing}}"
                  Stroke="{StaticResource Accent.Base}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="{Binding ProgressPercentText}" FontSize="48" FontWeight="Medium" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding ProgressCaption}" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="TimeHeadline" Text="{Binding TimeHeadline}" FontSize="18" FontWeight="Medium" TextAlignment="Center"/>
          <TextBlock Text="{Binding ElapsedFormatted, StringFormat=Elapsed {0}}" TextAlignment="Center"
                     Foreground="{StaticResource Text.Secondary}" Margin="0,7,0,0"/>
          <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,1" Padding="0,14" Margin="0,24,0,0"
                  Visibility="{Binding IsExporting, Converter={StaticResource Bool2Vis}}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Ellipse Width="7" Height="7" Fill="{StaticResource Accent.Base}" Margin="0,0,12,0"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding CurrentPartHeading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="EncodingProgressLine" Text="{Binding ProgressLine}" Foreground="{StaticResource Text.Secondary}"
                           FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding CurrentPart.StatusText}" Foreground="{StaticResource Text.Secondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <TextBlock x:Name="CleanupWarningText" Text="{Binding CleanupWarning}" Foreground="{StaticResource State.Warning}" TextWrapping="Wrap" Margin="0,12,0,0">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
              <DataTrigger Binding="{Binding CleanupWarning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"
                      Visibility="{Binding IsCompleted, Converter={StaticResource Bool2Vis}}">
            <Button Content="Open video" Click="OnOpenVideo" Margin="0,0,8,0"/>
            <Button Content="Open folder" Click="OnOpenFolder"/>
          </StackPanel>
          <TextBlock x:Name="PartsSummaryText" Text="{Binding PartsSummary}" HorizontalAlignment="Center"
                     Foreground="{StaticResource Text.Secondary}" FontSize="12" Margin="0,16"
                     TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- Error banner - only when in failed/cancelled state -->
        <Border x:Name="ProgressError" Grid.Row="1" Margin="24,12,24,0" Padding="12,10"
                Background="{StaticResource Bg.Surface2}"
                BorderBrush="{StaticResource State.Danger}" BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding IsFailed, Converter={StaticResource Bool2Vis}}">
          <StackPanel>
            <TextBlock Text="Reason" Style="{StaticResource Text.SectionLabel}"
                       Foreground="{StaticResource State.Danger}" FontSize="11"/>
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource Text.Primary}" Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
            </ScrollViewer>
            <Button Content="Retry using software" Click="OnRetrySoftware" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Visibility="{Binding CanRetrySoftware, Converter={StaticResource Bool2Vis}}"/>
          </StackPanel>
        </Border>



        <!-- Footer -->
        </StackPanel>
        </ScrollViewer>
        <Border x:Name="ProgressFooter" Grid.Row="1" Background="Transparent"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
                Padding="20,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Exporting: Cancel export | Run in background -->
            <Button Grid.Column="0" Style="{StaticResource Button.Danger}" Click="OnCancelExport"
                    Content="Cancel export"
                    Visibility="{Binding IsExporting, Converter={StaticResource Bool2Vis}}"/>
            <!-- Return after completion, failure, or cancellation. -->
            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Click="OnCloseTerminal"
                    Content="Back to editing"
                    Visibility="{Binding IsTerminal, Converter={StaticResource Bool2Vis}}"/>
          </Grid>
        </Border>
        </Grid>
        <Border x:Name="ProgressDetails" Grid.Column="1" Background="{StaticResource Bg.Surface2}" CornerRadius="7" Margin="24,0,0,0" Padding="20">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="ProgressDetailsTitle" Text="Export details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
          <ScrollViewer x:Name="PartsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
        <!-- Output destination card -->
        <Border Margin="0,0,0,0"
                Background="{StaticResource Bg.Surface2}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                CornerRadius="6" Padding="14,12">
          <Grid x:Name="ExportDestinationDetails">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="SAVING TO"
                       Style="{StaticResource Text.SectionLabel}"
                       Foreground="{StaticResource Text.Tertiary}" FontSize="11"
                       Margin="0,0,18,4" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding OutputFolder}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="13"
                       Foreground="{StaticResource Text.Primary}" Margin="0,0,0,4"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="FILENAME"
                       Style="{StaticResource Text.SectionLabel}"
                       Foreground="{StaticResource Text.Tertiary}" FontSize="11"
                       Margin="0,0,18,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding OutputFilename}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="13"
                       Foreground="{StaticResource Text.Primary}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="ENCODER"
                       Style="{StaticResource Text.SectionLabel}"
                       Foreground="{StaticResource Text.Tertiary}" FontSize="11"
                       Margin="0,4,18,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ExportMethodValue" Grid.Row="2" Grid.Column="1"
                       Text="{Binding ExportMethodLabel}" ToolTip="{Binding ActiveEncoder}"
                       FontFamily="{StaticResource Font.Mono}" FontSize="13" Margin="0,4,0,0"
                       Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>

        <!-- Duration stats (reuse the same three-column layout from configuring view) -->
        <Border Margin="0,12,0,0"
                Background="{StaticResource Bg.Surface2}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1"
                CornerRadius="6" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="SOURCE" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBlock Text="{Binding SourceDurationUs, Converter={StaticResource TimeFmt}}"
                         FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                         Foreground="{StaticResource Text.Primary}" Margin="0,2,0,0"/>
            </StackPanel>
            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Border.Subtle}" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="2">
              <TextBlock Text="EXCLUDED" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                         Foreground="{StaticResource State.Warning}" Margin="0,2,0,0"
                         Text="{Binding ExcludedDurationUs, Converter={StaticResource TimeFmt}, StringFormat=−{0}}"/>
            </StackPanel>
            <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Border.Subtle}" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="4">
              <TextBlock Text="FINAL" Style="{StaticResource Text.SectionLabel}"
                         Foreground="{StaticResource Text.Tertiary}" FontSize="11"/>
              <TextBlock Text="{Binding FinalDurationUs, Converter={StaticResource TimeFmt}}"
                         FontFamily="{StaticResource Font.Mono}" FontSize="18" FontWeight="Medium"
                         Foreground="{StaticResource State.Success}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Parts list -->
        <Border Margin="0,16,0,0"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0">
          <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="1" Text="{Binding FallbackNotice}" Foreground="{StaticResource State.Warning}" TextWrapping="Wrap" Margin="0,3,0,8">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FallbackNotice}" Value="">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="2" Text="PARTS" Style="{StaticResource Text.SectionLabel}"
                       Foreground="{StaticResource Text.Tertiary}" FontSize="11"
                       Margin="0,0,0,8"/>

            <ItemsControl x:Name="ExportPartsList" Grid.Row="3" ItemsSource="{Binding Parts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="220"/>
                      <ColumnDefinition Width="76"/>
                      <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status icon: queued = open circle, in-progress = filled
                         dot, done = check. We swap visibility per state. -->
                    <Ellipse Grid.Column="0" Width="11" Height="11" StrokeThickness="1.5"
                             Stroke="{StaticResource Border.Strong}" Fill="Transparent"
                             Visibility="{Binding IsQueued, Converter={StaticResource Bool2Vis}}"/>
                    <Path Grid.Column="0" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{StaticResource Accent.Base}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Fill="Transparent"
                          Data="M 6,1 A 5,5 0 1 1 1,6"
                          RenderTransformOrigin="0.5,0.5"
                          Visibility="{Binding IsInProgress, Converter={StaticResource Bool2Vis}}">
                      <Path.RenderTransform>
                        <RotateTransform Angle="0"/>
                      </Path.RenderTransform>
                      <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                          <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                              <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                From="0" To="360" Duration="0:0:1"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Path.Triggers>
                    </Path>
                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                          Stroke="{StaticResource State.Success}" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5,12 L10,17 L19,7"
                          Visibility="{Binding IsDone, Converter={StaticResource Bool2Vis}}"/>
                    <Path Grid.Column="0" Width="11" Height="11" Stretch="Uniform"
                          Stroke="{StaticResource State.Danger}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M6,6 L18,18 M18,6 L6,18"
                          Visibility="{Binding IsFailed, Converter={StaticResource Bool2Vis}}"/>

                    <TextBlock x:Name="PartName" Grid.Column="1" Text="{Binding Label}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"
                               Foreground="{StaticResource Text.Primary}" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="8,0,16,0"/>
                    <TextBlock x:Name="PartRange" Grid.Column="2" Text="{Binding TimeRange}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,16,0"
                               ToolTip="{Binding TimeRange}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding ElapsedFormatted}"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource Text.Secondary}"
                               TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" TextAlignment="Right"
                               FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource Text.Tertiary}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </Grid>
        </Border>

            </StackPanel>
          </ScrollViewer>


          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
