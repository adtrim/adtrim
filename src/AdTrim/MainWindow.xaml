<Window x:Class="AdTrim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:app="clr-namespace:AdTrim"
        xmlns:ctrls="clr-namespace:AdTrim.Controls"
        xmlns:conv="clr-namespace:AdTrim.Converters"
        xmlns:vm="clr-namespace:AdTrim.ViewModels"
        xmlns:views="clr-namespace:AdTrim.Views"
        AllowDrop="True"
        Drop="OnDrop"
        SourceInitialized="OnSourceInitialized"
        SizeChanged="OnWindowSizeChanged"
        Title="AdTrim"
        Icon="pack://application:,,,/icon-512.png"
        Width="1280" Height="832"
        MinWidth="1280" MinHeight="832"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Window}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <conv:TimeFormatConverter x:Key="TimeFmt"/>
    <conv:EnumEqualsVisibilityConverter x:Key="EnumEqVis"/>
    <conv:EnumNotEqualsVisibilityConverter x:Key="EnumNeVis"/>
    <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
    <conv:BoolToCollapsedConverter x:Key="Bool2Collapse"/>
    <conv:StatusKindToBrushConverter x:Key="StatusKindBrush"/>
    <conv:StatusKindToBannerBgConverter x:Key="StatusKindBannerBg"/>
    <conv:ProgressTrackWidthConverter x:Key="ProgressTrackWidth"/>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome
      CaptionHeight="32"
      ResizeBorderThickness="6"
      CornerRadius="0"
      GlassFrameThickness="0"
      UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>   <!-- Title bar -->
      <RowDefinition Height="32"/>   <!-- Menu bar -->
      <RowDefinition Height="*"/>    <!-- Video pane -->
      <RowDefinition Height="Auto"/> <!-- Banner (collapsed by default) -->
      <RowDefinition Height="56"/>   <!-- Transport bar -->
      <RowDefinition Height="40"/>   <!-- Timeline toolbar -->
      <RowDefinition Height="182"/>  <!-- Timeline strip wrapper (174 + pad) -->
      <RowDefinition Height="26"/>   <!-- Status bar -->
    </Grid.RowDefinitions>

    <!-- =============================================================== -->
    <!-- TITLE BAR (custom Win11-ish)                                     -->
    <!-- =============================================================== -->
    <Border Grid.Row="0" Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Title + filename -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <!-- App icon -->
          <Image Source="pack://application:,,,/icon-512.png"
                 Width="14" Height="14" Margin="0,0,8,0"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                     Foreground="{StaticResource Text.Primary}" FontWeight="Medium" FontSize="13"
                     VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}">
            <TextBlock Text="-" Foreground="{StaticResource Text.Tertiary}" Margin="6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding FileName}"
                       FontFamily="{StaticResource Font.Mono}"
                       Foreground="{StaticResource Text.Secondary}" FontSize="12"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>

        <!-- Min / Max / Close -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinButton" Style="{StaticResource WindowControlButton}" Click="OnMinimize">
            <Path Stroke="{StaticResource Text.Secondary}" StrokeThickness="1" Data="M0,5 L10,5"/>
          </Button>
          <Button x:Name="MaxButton" Style="{StaticResource WindowControlButton}" Click="OnMaximize">
            <Path x:Name="MaxButtonIcon" Stroke="{StaticResource Text.Secondary}" StrokeThickness="1"
                  Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource WindowControlButton.Close}" Click="OnClose">
            <Path Stroke="{StaticResource Text.Secondary}" StrokeThickness="1" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- =============================================================== -->
    <!-- MENU BAR                                                         -->
    <!-- =============================================================== -->
    <Border Grid.Row="1" Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Menu Grid.Column="0" VerticalAlignment="Stretch" Padding="4,0">
          <MenuItem Header="_File" Style="{StaticResource MenuBarItem}">
            <MenuItem Header="Open…"             InputGestureText="Ctrl+O"        Style="{StaticResource DropdownMenuItem}" Click="OnOpenFile"/>
            <MenuItem Header="Open Recent"       InputGestureText="▸"             Style="{StaticResource DropdownMenuItem}" IsEnabled="False"/>
            <Separator Background="{StaticResource Border.Subtle}"/>
            <MenuItem Header="Save project"      InputGestureText="Ctrl+S"        Style="{StaticResource DropdownMenuItem}" Click="OnSaveProject"/>
            <Separator Background="{StaticResource Border.Subtle}"/>
            <MenuItem Header="Export merged MP4…" InputGestureText="E"            Style="{StaticResource DropdownMenuItem}" Click="OnExport"/>
            <Separator Background="{StaticResource Border.Subtle}"/>
            <MenuItem Header="Close project"     InputGestureText="Ctrl+W"        Style="{StaticResource DropdownMenuItem}" Click="OnCloseProject"/>
            <MenuItem Header="Exit"              InputGestureText="Alt+F4"        Style="{StaticResource DropdownMenuItem}" Click="OnClose"/>
          </MenuItem>
          <MenuItem Header="_Edit" Style="{StaticResource MenuBarItem}">
            <MenuItem Header="Undo"                       InputGestureText="Ctrl+Z"        Style="{StaticResource DropdownMenuItem}" Click="OnUndo"/>
            <MenuItem Header="Redo"                       InputGestureText="Ctrl+Y"        Style="{StaticResource DropdownMenuItem}" Click="OnRedo"/>
            <Separator Background="{StaticResource Border.Subtle}"/>
            <MenuItem Header="Add split at playhead"      InputGestureText="S"             Style="{StaticResource DropdownMenuItem}" Click="OnAddSplitAtPlayhead"/>
            <MenuItem Header="Delete selected split"      InputGestureText="Del"           Style="{StaticResource DropdownMenuItem}" Click="OnDeleteSelectedSplit"/>
            <Separator Background="{StaticResource Border.Subtle}"/>
            <MenuItem Header="Confirm split"              InputGestureText="C"             Style="{StaticResource DropdownMenuItem}" Click="OnConfirmSelectedSplit"/>
            <MenuItem Header="Confirm all remaining"      InputGestureText="Ctrl+Shift+C"  Style="{StaticResource DropdownMenuItem}" Click="OnConfirmAllRemaining"/>
            <Separator Background="{StaticResource Border.Subtle}"/>
            <MenuItem Header="Mark segment as excluded"   InputGestureText="X"             Style="{StaticResource DropdownMenuItem}" Click="OnToggleExcluded"/>
          </MenuItem>
          <MenuItem Header="_View" Style="{StaticResource MenuBarItem}">
            <MenuItem Header="Zoom in"        InputGestureText="Ctrl+="  Style="{StaticResource DropdownMenuItem}" Click="OnZoomIn"/>
            <MenuItem Header="Zoom out"       InputGestureText="Ctrl+−"  Style="{StaticResource DropdownMenuItem}" Click="OnZoomOut"/>
            <MenuItem Header="Fit timeline"   InputGestureText="Ctrl+0"  Style="{StaticResource DropdownMenuItem}" Click="OnFitTimeline"/>
            <Separator Background="{StaticResource Border.Subtle}"/>
            <MenuItem Header="Show waveform"   IsCheckable="True" IsChecked="{Binding ShowWaveform, Mode=TwoWay}" Style="{StaticResource DropdownMenuItem}"/>
            <MenuItem Header="Show thumbnails" IsCheckable="True" IsChecked="{Binding ShowThumbnails, Mode=TwoWay}" Style="{StaticResource DropdownMenuItem}"/>
            <MenuItem Header="Show ruler ticks" IsCheckable="True" IsChecked="{Binding ShowRulerTicks, Mode=TwoWay}" Style="{StaticResource DropdownMenuItem}"/>
            <Separator Background="{StaticResource Border.Subtle}"/>
            <MenuItem x:Name="FrameAccurateSeekMenuItem"
                      Header="Frame-accurate seek (slower)"
                      IsCheckable="True"
                      Style="{StaticResource DropdownMenuItem}"
                      Click="OnToggleFrameAccurateSeek"/>
            <Separator Background="{StaticResource Border.Subtle}"/>
            <MenuItem Header="Jump to next unconfirmed split" InputGestureText="N" Style="{StaticResource DropdownMenuItem}" Click="OnJumpNextUnconfirmed"/>
          </MenuItem>
          <MenuItem Header="_Tools" Style="{StaticResource MenuBarItem}">
            <MenuItem Header="Refine all splits"          InputGestureText="Ctrl+R" Style="{StaticResource DropdownMenuItem}" Click="OnRefineAll"/>
            <MenuItem Header="Refine selected split"      InputGestureText="R"      Style="{StaticResource DropdownMenuItem}" Click="OnRefineSelected"/>
            <Separator Background="{StaticResource Border.Subtle}"/>
            <MenuItem Header="Preview ±2s around split"   InputGestureText="P"      Style="{StaticResource DropdownMenuItem}" Click="OnPreviewSelectedSplit"/>
            <MenuItem Header="Auto-confirm high-confidence" Style="{StaticResource DropdownMenuItem}" Click="OnAutoConfirmHighConfidence"/>
          </MenuItem>
          <MenuItem Header="_Help" Style="{StaticResource MenuBarItem}">
            <MenuItem Header="About AdTrim" Style="{StaticResource DropdownMenuItem}" Click="OnAbout"/>
          </MenuItem>
        </Menu>

        <!-- Right side: empty. The Export action moved down into the transport
             bar next to the timecode readout - the menu-bar chrome was too
             close to window controls to notice. File menu still has it and
             E still works. -->
        <StackPanel Grid.Column="1"/>
      </Grid>
    </Border>

    <!-- =============================================================== -->
    <!-- DUAL VIDEO PANE - two MPV HwndHosts side-by-side.                -->
    <!--                                                                  -->
    <!-- Pane A ("Before split") shows playhead − 1 frame. Has audio.     -->
    <!-- Pane B ("After split")  shows the playhead exactly. Muted (the   -->
    <!--   two panes play the same file 1 frame apart - unmuting both     -->
    <!--   would comb-filter the audio).                                  -->
    <!--                                                                  -->
    <!-- The "No frame available" overlay covers Pane A when playhead = 0 -->
    <!-- (i.e. playhead − 1f is before the start of the file).            -->
    <!--                                                                  -->
    <!-- HwndHost airspace: the two MpvVideoViews are SIBLINGS in their   -->
    <!-- own Grid columns - they don't overlap, so each owns its own      -->
    <!-- rectangle outright. The placeholder gradient + EmptyStateView    -->
    <!-- still cover both panes via ColumnSpan until media is loaded.     -->
    <!-- =============================================================== -->
    <Grid Grid.Row="2" Background="Black">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Placeholder scene (visible until media is opened). Spans both
           columns so the gradient looks coherent edge-to-edge. -->
      <Border x:Name="VideoPlaceholder" Grid.ColumnSpan="2" Visibility="Visible">
        <Border.Background>
          <RadialGradientBrush Center="0.5,0.55" GradientOrigin="0.4,0.4" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#FF1A2235" Offset="0"/>
            <GradientStop Color="#FF0E1320" Offset="0.6"/>
            <GradientStop Color="#FF050A14" Offset="1"/>
          </RadialGradientBrush>
        </Border.Background>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource Text.Tertiary}" FontSize="13">
          Drop an MP4 to start editing - or use File ▸ Open…
        </TextBlock>
      </Border>

      <!-- Pane A: BEFORE split (playhead − 1 frame, has audio).
           (Video + chip) are wrapped in a vertical StackPanel that is
           centered in the available pane area. HwndHost is sized to the
           video's display aspect (see ApplyAspectFit in code-behind), so
           the chip sits flush beneath the video frame and any leftover
           black distributes equally top and bottom rather than dumping
           entirely above the video. -->
      <Grid Grid.Column="0" x:Name="PaneAGrid" SizeChanged="OnPaneSizeChanged">
        <!-- Black overlay with "No frame available" when t − 1f is before
             frame 0. Sibling-swap with the HwndHost: when this is Visible,
             MpvViewBefore is Collapsed (so the HWND isn't competing for the
             rect). Fills the whole pane. -->
        <Grid x:Name="NoFrameOverlay" Background="Black" Visibility="Collapsed">
          <TextBlock Text="No frame available"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource Text.Tertiary}" FontSize="14"/>
        </Grid>
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <ctrls:MpvVideoView x:Name="MpvViewBefore" Visibility="Collapsed"
                              HorizontalAlignment="Center"/>
          <!-- Live mpv-reported timestamp + frame index. Frame index in a
               dimmer color so the position pops at a glance. -->
          <Border HorizontalAlignment="Center" Margin="0,4,0,0"
                  Background="#CC000000" CornerRadius="4" Padding="6,3"
                  Visibility="{Binding ElementName=MpvViewBefore, Path=Visibility}">
            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12">
              <Run x:Name="TimestampBeforePos" Text="00:00:00.000" Foreground="White"/><Run Text=" / frame: " Foreground="{StaticResource Text.Tertiary}"/><Run x:Name="TimestampBeforeFrame" Text="0" Foreground="{StaticResource Text.Secondary}"/>
            </TextBlock>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Pane B: AFTER split (playhead, muted). Same wrapper as Pane A. -->
      <Grid Grid.Column="1" x:Name="PaneBGrid" SizeChanged="OnPaneSizeChanged">
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <ctrls:MpvVideoView x:Name="MpvViewAfter" Visibility="Collapsed"
                              HorizontalAlignment="Center"/>
          <Border HorizontalAlignment="Center" Margin="0,4,0,0"
                  Background="#CC000000" CornerRadius="4" Padding="6,3"
                  Visibility="{Binding ElementName=MpvViewAfter, Path=Visibility}">
            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12">
              <Run x:Name="TimestampAfterPos" Text="00:00:00.000" Foreground="White"/><Run Text=" / frame: " Foreground="{StaticResource Text.Tertiary}"/><Run x:Name="TimestampAfterFrame" Text="0" Foreground="{StaticResource Text.Secondary}"/>
            </TextBlock>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- =============================================================== -->
    <!-- EMPTY STATE - fills the editor-body rows when no file is loaded -->
    <!-- =============================================================== -->
    <Border Grid.Row="2" Grid.RowSpan="5"
            Background="{StaticResource Bg.Window}"
            Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Collapse}}">
      <views:EmptyStateView/>
    </Border>

    <!-- =============================================================== -->
    <!-- INLINE BANNER (above transport, design screen 10)                -->
    <!-- =============================================================== -->
    <Border Grid.Row="3"
            Visibility="{Binding HasBanner, Converter={StaticResource Bool2Vis}}"
            Background="{Binding Banner.Kind, Converter={StaticResource StatusKindBannerBg}}"
            BorderBrush="{StaticResource Border.Subtle}"
            BorderThickness="0,1">
      <Grid Margin="16,10,16,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3"/>
          <ColumnDefinition Width="24"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" VerticalAlignment="Stretch" Margin="0,-10,12,-10"
                   Fill="{Binding Banner.Kind, Converter={StaticResource StatusKindBrush}}"/>
        <Path Grid.Column="1" Width="14" Height="14" Stretch="Uniform"
              Stroke="{Binding Banner.Kind, Converter={StaticResource StatusKindBrush}}"
              StrokeThickness="1.6" Fill="Transparent"
              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M12,4 L21,20 L3,20 Z M12,10 L12,14 M12,17 L12,17"
              VerticalAlignment="Top" Margin="0,2,0,0"/>
        <StackPanel Grid.Column="2" Margin="6,0,12,0">
          <TextBlock Text="{Binding Banner.Title}" FontWeight="SemiBold"
                     Foreground="{StaticResource Text.Primary}" FontSize="13"/>
          <TextBlock Text="{Binding Banner.Body}" Foreground="{StaticResource Text.Secondary}"
                     FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ItemsControl Grid.Column="3" ItemsSource="{Binding Banner.Actions}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Label}" Margin="0,0,6,0"
                      Style="{StaticResource BannerActionButton}"
                      Click="OnBannerActionClick" Tag="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="24" Height="24"
                Click="OnDismissBanner" ToolTip="Dismiss">
          <Path Width="10" Height="10" Stretch="Uniform"
                Stroke="{StaticResource Text.Secondary}" StrokeThickness="1.6"
                Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"/>
        </Button>
      </Grid>
    </Border>

    <!-- =============================================================== -->
    <!-- TRANSPORT BAR                                                    -->
    <!-- =============================================================== -->
    <Border Grid.Row="4" Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1"
            Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Transport controls -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" ToolTip="Previous split (↑)" Click="OnPreviousSplit">
            <Path Fill="{StaticResource Text.Primary}" Width="14" Height="14" Stretch="Uniform"
                  Data="M18,4 L8,12 L18,20 Z M5,4 L7,4 L7,20 L5,20 Z"/>
          </Button>
          <Button Style="{StaticResource IconButton}" ToolTip="−1 frame (←)" Click="OnStepFrameBack">
            <Path Stroke="{StaticResource Text.Primary}" StrokeThickness="1.6" Fill="Transparent"
                  Width="14" Height="14" Stretch="Uniform"
                  Data="M14,7 L9,12 L14,17 M6,5 L6,19" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="PlayPauseButton"
                  Style="{StaticResource IconButton.PlayPause}" ToolTip="Play / Pause (Space)"
                  Click="OnPlayPauseClicked">
            <Grid>
              <!-- Pause icon (two bars) - shown while playing -->
              <Grid x:Name="PauseGlyph" Visibility="Collapsed">
                <Rectangle Width="3" Height="12" Margin="0,0,8,0" Fill="{StaticResource Text.Primary}"/>
                <Rectangle Width="3" Height="12" Margin="8,0,0,0" Fill="{StaticResource Text.Primary}"/>
              </Grid>
              <!-- Play icon (triangle) - shown while paused/stopped -->
              <Polygon x:Name="PlayGlyph"
                       Points="0,0 0,12 11,6" Fill="{StaticResource Text.Primary}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Style="{StaticResource IconButton}" ToolTip="+1 frame (→)" Click="OnStepFrameForward">
            <Path Stroke="{StaticResource Text.Primary}" StrokeThickness="1.6" Fill="Transparent"
                  Width="14" Height="14" Stretch="Uniform"
                  Data="M10,7 L15,12 L10,17 M18,5 L18,19" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button Style="{StaticResource IconButton}" ToolTip="Next split (↓)" Click="OnNextSplit">
            <Path Fill="{StaticResource Text.Primary}" Width="14" Height="14" Stretch="Uniform"
                  Data="M6,4 L16,12 L6,20 Z M17,4 L19,4 L19,20 L17,20 Z"/>
          </Button>
        </StackPanel>

        <Rectangle Grid.Column="1" Width="1" Height="24" Fill="{StaticResource Border.Subtle}" Margin="10,0"/>

        <!-- Timecode readout -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox Style="{StaticResource SelectableText}"
                   Text="{Binding PlayheadUs, Converter={StaticResource TimeFmt}, Mode=OneWay}"
                   FontFamily="{StaticResource Font.Mono}" FontSize="20" FontWeight="Medium"
                   Foreground="{StaticResource Text.Primary}"/>
          <TextBlock Text=" / " FontSize="14" Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
          <TextBox Style="{StaticResource SelectableText}"
                   Text="{Binding DurationUs, Converter={StaticResource TimeFmt}, Mode=OneWay}"
                   FontFamily="{StaticResource Font.Mono}" FontSize="14"
                   Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding MediaInfoLine}" FontFamily="{StaticResource Font.Mono}"
                     FontSize="11" Foreground="{StaticResource Text.Tertiary}"
                     VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- Export action - placed adjacent to the timecode so it's where the
             eye lands while reasoning about "how much will get exported,"
             instead of buried up in the menu-bar chrome. File menu still has
             "Export merged MP4…" and E still works. -->
        <Button Grid.Column="3" Style="{StaticResource Button.Primary}"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="16,0,0,0" Padding="12,5"
                Click="OnExport" IsEnabled="{Binding IsFileLoaded}">
          <StackPanel Orientation="Horizontal">
            <Path Data="M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20"
                  Stroke="White" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"
                  Margin="0,0,6,0" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <TextBlock Foreground="White">
              Export
              <Run Text=" (E)" Foreground="#8CFFFFFF"/>
            </TextBlock>
          </StackPanel>
        </Button>

        <!-- Right: volume + zoom -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="MuteButton" Style="{StaticResource IconButton}"
                  ToolTip="Mute / unmute (left pane)" Click="OnToggleMute">
            <Grid Width="16" Height="16">
              <!-- Unmuted: speaker + two sound waves. -->
              <Path x:Name="SpeakerOnGlyph" Stroke="{StaticResource Text.Primary}" StrokeThickness="1.6"
                    Fill="Transparent" Stretch="Uniform" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M4,9 L8,9 L13,5 L13,19 L8,15 L4,15 Z M16,8.5 C17.2,9.5 17.2,14.5 16,15.5 M18.5,6 C20.5,7.8 20.5,16.2 18.5,18"/>
              <!-- Muted: same speaker body + small X where the waves were. -->
              <Path x:Name="SpeakerOffGlyph" Stroke="{StaticResource Text.Secondary}" StrokeThickness="1.6"
                    Fill="Transparent" Stretch="Uniform" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                    Data="M4,9 L8,9 L13,5 L13,19 L8,15 L4,15 Z M16,8 L21,13 M21,8 L16,13"/>
            </Grid>
          </Button>
          <Rectangle Width="1" Height="20" Fill="{StaticResource Border.Subtle}" Margin="6,0"/>
          <Button Style="{StaticResource IconButton}" ToolTip="Zoom out" Click="OnZoomOut">
            <Path Stroke="{StaticResource Text.Primary}" StrokeThickness="1.6" Fill="Transparent"
                  Width="16" Height="16" Stretch="Uniform"
                  Data="M11,5 A6,6 0 1 0 11,17 A6,6 0 1 0 11,5 M8,11 L14,11 M15.5,15.5 L20,20"/>
          </Button>
          <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Text.Secondary}"
                     Width="36" TextAlignment="Center" VerticalAlignment="Center"
                     Text="{Binding ZoomFactor, StringFormat={}{0:0.0}×}"/>
          <Button Style="{StaticResource IconButton}" ToolTip="Zoom in" Click="OnZoomIn">
            <Path Stroke="{StaticResource Text.Primary}" StrokeThickness="1.6" Fill="Transparent"
                  Width="16" Height="16" Stretch="Uniform"
                  Data="M11,5 A6,6 0 1 0 11,17 A6,6 0 1 0 11,5 M11,8 L11,14 M8,11 L14,11 M15.5,15.5 L20,20"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- =============================================================== -->
    <!-- TIMELINE TOOLBAR - three layouts overlap, one visible at a time  -->
    <!-- =============================================================== -->
    <Border Grid.Row="5" Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
            Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}">
      <Grid Margin="16,0">

        <!-- Left actions - marker-specific buttons collapse when no marker
             is selected; "Add split at playhead" is the only always-present
             item here. Frame-nudge buttons were removed: that's keyboard
             territory (`,` / `.`, arrow keys, `[` / `]`) and a dedicated
             button per shortcut would crowd the toolbar. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
          <!-- Anchor: "Add split at playhead" stays leftmost regardless of
               selection state so it doesn't jump when markers are
               selected/deselected. -->
          <Button Padding="10,5" Click="OnAddSplitAtPlayhead">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="+" FontSize="14" FontWeight="Medium"
                         Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0"/>
              <TextBlock>
                <Run Text="Add split at playhead"/>
                <Run Text=" (S)" Foreground="{StaticResource Text.Tertiary}"/>
              </TextBlock>
            </StackPanel>
          </Button>
          <Button Padding="10,4" Margin="4,0,0,0" Click="OnPreviewSelectedSplit"
                  Visibility="{Binding SelectionKind, Converter={StaticResource EnumEqVis}, ConverterParameter=Marker}">
            <StackPanel Orientation="Horizontal">
              <Polygon Points="6,4 20,12 6,20" Width="9" Height="9" Fill="{StaticResource Accent.Base}" Margin="0,0,4,0"/>
              <TextBlock>
                <Run Text="Preview split"/>
                <Run Text=" (P)" Foreground="{StaticResource Text.Tertiary}"/>
              </TextBlock>
            </StackPanel>
          </Button>
          <Button Padding="10,4" Margin="4,0,0,0" Click="OnRefineSelected"
                  Visibility="{Binding SelectionKind, Converter={StaticResource EnumEqVis}, ConverterParameter=Marker}">
            <StackPanel Orientation="Horizontal">
              <Path Fill="{StaticResource Accent.Base}" Width="11" Height="11" Stretch="Uniform"
                    Data="M12,3 L13.4,7.2 L17.6,8.6 L13.4,10 L12,14.2 L10.6,10 L6.4,8.6 L10.6,7.2 Z"
                    Margin="0,0,4,0"/>
              <TextBlock>
                <Run Text="Refine this split"/>
                <Run Text=" (R)" Foreground="{StaticResource Text.Tertiary}"/>
              </TextBlock>
            </StackPanel>
          </Button>
          <Button Padding="8,4" Margin="4,0,0,0" Click="OnMoveSelectedToPlayhead"
                  Visibility="{Binding SelectionKind, Converter={StaticResource EnumEqVis}, ConverterParameter=Marker}">
            <TextBlock>
              <Run Text="Move to playhead"/>
              <Run Text=" (M)" Foreground="{StaticResource Text.Tertiary}"/>
            </TextBlock>
          </Button>
          <Button Style="{StaticResource Button.Primary}" Padding="10,4" Margin="4,0,0,0" Click="OnConfirmSelectedSplit"
                  Visibility="{Binding SelectionKind, Converter={StaticResource EnumEqVis}, ConverterParameter=Marker}">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Stretch="Uniform"
                    Stroke="White" StrokeThickness="2" Fill="Transparent"
                    StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M5,12 L10,17 L19,7" Margin="0,0,4,0"/>
              <TextBlock Foreground="White">
                Confirm
                <Run Text=" (C)" Foreground="#8CFFFFFF"/>
              </TextBlock>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Danger}" Padding="10,4" Margin="4,0,0,0"
                  Click="OnDeleteSelectedSplit"
                  Visibility="{Binding SelectionKind, Converter={StaticResource EnumEqVis}, ConverterParameter=Marker}">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Stretch="Uniform"
                    Stroke="White" StrokeThickness="2" Fill="Transparent"
                    StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M6,6 L18,18 M18,6 L6,18" Margin="0,0,4,0"/>
              <TextBlock Foreground="White">
                Delete
                <Run Text=" (Del)" Foreground="#8CFFFFFF"/>
              </TextBlock>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Right actions - global (not tied to any selection). -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <!-- Last-refine summary chip. Persists until the next pass starts;
               complements the dismissible banner with a quiet at-a-glance
               reference of the last outcome (high / medium / low / unchanged). -->
          <Border Margin="0,0,8,0" Padding="8,3" CornerRadius="3"
                  Background="{StaticResource Bg.Lane}"
                  VerticalAlignment="Center"
                  Visibility="{Binding HasRefineSummary, Converter={StaticResource Bool2Vis}}"
                  ToolTip="Last refine pass result.">
            <TextBlock Text="{Binding RefineSummary}" FontSize="11"
                       FontFamily="{StaticResource Font.Mono}"
                       Foreground="{StaticResource Text.Secondary}"/>
          </Border>
          <Button Padding="10,5" Click="OnRefineAll">
            <StackPanel Orientation="Horizontal">
              <Path Fill="{StaticResource Accent.Base}" Width="13" Height="13" Stretch="Uniform"
                    Data="M12,3 L13.4,7.2 L17.6,8.6 L13.4,10 L12,14.2 L10.6,10 L6.4,8.6 L10.6,7.2 Z M18,14 L18.7,16.1 L20.8,16.8 L18.7,17.5 L18,19.6 L17.3,17.5 L15.2,16.8 L17.3,16.1 Z"
                    Margin="0,0,6,0"/>
              <TextBlock>
                <Run Text="Refine all splits"/>
                <Run Text=" (Ctrl+R)" Foreground="{StaticResource Text.Tertiary}"/>
              </TextBlock>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Segment-selected layout (chip + Mark/Un-exclude button) -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Visibility="{Binding SelectionKind, Converter={StaticResource EnumEqVis}, ConverterParameter=Segment}">
          <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{StaticResource Bg.Surface2}" BorderBrush="{StaticResource Border.Subtle}"
                  BorderThickness="1" CornerRadius="999" Padding="12,3">
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2"
                         Fill="{StaticResource Accent.Base}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Segment " Foreground="{StaticResource Text.Primary}" FontWeight="Medium" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SelectedSegment.Label}" Foreground="{StaticResource Text.Primary}" FontWeight="Medium" VerticalAlignment="Center"/>
              <TextBlock Text=" · " Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SelectedSegment.StartUs, Converter={StaticResource TimeFmt}}"
                         FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center"/>
              <TextBlock Text=" → " Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SelectedSegment.EndUs, Converter={StaticResource TimeFmt}}"
                         FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center"/>
              <TextBlock Text=" · " Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SelectedSegment.DurationUs, Converter={StaticResource TimeFmt}}"
                         FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Warning}" Padding="10,4" Click="OnToggleExcluded">
              <StackPanel Orientation="Horizontal">
                <Path Width="11" Height="11" Stretch="Uniform"
                      Stroke="{StaticResource State.Warning}" StrokeThickness="1.6" Fill="Transparent"
                      Data="M7,7 L17,17 M7,17 L17,7 M7,7 A2.5,2.5 0 1 0 7,7.1 M7,17 A2.5,2.5 0 1 0 7,17.1"
                      Margin="0,0,4,0"/>
                <TextBlock Text="Mark segment as excluded"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- =============================================================== -->
    <!-- TIMELINE STRIP                                                   -->
    <!-- =============================================================== -->
    <Border Grid.Row="6" Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
            Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}">
      <ScrollViewer x:Name="TimelineScroll"
                    Margin="16,8,16,0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    SizeChanged="OnTimelineScrollSizeChanged"
                    PreviewMouseDown="OnTimelineMouseDown"
                    PreviewMouseMove="OnTimelineMouseMove"
                    PreviewMouseUp="OnTimelineMouseUp"
                    Background="Transparent">
        <ctrls:TimelineView x:Name="Timeline"
                            AuditionRequested="OnTimelineAuditionRequested"
                            RefineRequested="OnTimelineRefineRequested"
                            ConfirmedMarkerUnlockRequested="OnTimelineConfirmedMarkerUnlockRequested"
                            NudgeRequested="OnTimelineNudgeRequested"
                            SeekRequested="OnTimelineSeekRequested"/>
      </ScrollViewer>
    </Border>

    <!-- =============================================================== -->
    <!-- STATUS BAR                                                       -->
    <!-- =============================================================== -->
    <Border Grid.Row="7" Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: autosave indicator when file loaded; "Ready" otherwise. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}">
          <Ellipse Width="6" Height="6" Fill="{StaticResource State.Success}" Margin="0,0,6,0"/>
          <TextBlock Text="Saved 12s ago"
                     Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Collapse}}">
          <Ellipse Width="6" Height="6" Fill="{StaticResource State.Success}" Margin="0,0,6,0"/>
          <TextBlock Text="Ready" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
        </StackPanel>

        <Rectangle Grid.Column="1" Width="1" Height="14" Fill="{StaticResource Border.Subtle}" Margin="16,0"/>

        <!-- Empty-state center text -->
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                   Text="No file loaded"
                   Foreground="{StaticResource Text.Secondary}" FontSize="12"
                   Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Collapse}}"/>

        <!-- Status override (highest priority) - replaces selection-aware content.
             Clickable: brings a hidden ("Run in background") export dialog back. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnStatusOverrideClick"
                    ToolTip="Click to open the export progress window"
                    Visibility="{Binding HasStatusOverride, Converter={StaticResource Bool2Vis}}">
          <TextBlock Text="{Binding StatusOverride}" FontSize="12"
                     Foreground="{Binding StatusKind, Converter={StaticResource StatusKindBrush}}"/>
          <Border Width="60" Height="4" Background="{StaticResource Bg.Lane}" CornerRadius="2"
                  Margin="10,0,0,0" VerticalAlignment="Center"
                  Visibility="{Binding HasProgress, Converter={StaticResource Bool2Vis}}">
            <Rectangle HorizontalAlignment="Left"
                       Width="{Binding ProgressPercentValue, Converter={StaticResource ProgressTrackWidth}, ConverterParameter=60}"
                       Fill="{Binding StatusKind, Converter={StaticResource StatusKindBrush}}"
                       RadiusX="2" RadiusY="2"/>
          </Border>
        </StackPanel>

        <!-- Selection-aware default group - collapsed when override is set -->
        <Grid Grid.Column="2"
              Visibility="{Binding HasStatusOverride, Converter={StaticResource Bool2Collapse}}">
        <!-- Default: confirm-progress chip (only when a file is loaded
             AND no marker/segment selection is active) -->
        <Grid Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Visibility="{Binding SelectionKind, Converter={StaticResource EnumEqVis}, ConverterParameter=None}">
          <Path Width="12" Height="12" Stretch="Uniform"
                Stroke="{StaticResource State.Warning}" StrokeThickness="2"
                StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M5,12 L10,17 L19,7" Margin="0,0,6,0"/>
          <TextBlock FontFamily="{StaticResource Font.Mono}" FontWeight="Medium"
                     Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"
                     Text="{Binding ConfirmProgressLabel}"/>
          <TextBlock Text=" splits confirmed" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
          <Border Width="60" Height="4" Background="{StaticResource Bg.Lane}" CornerRadius="2"
                  Margin="8,0,0,0" VerticalAlignment="Center">
            <Border HorizontalAlignment="Left"
                    Width="{Binding ConfirmProgressPercent, Converter={StaticResource ProgressTrackWidth}, ConverterParameter=60}"
                    Background="{StaticResource Accent.Base}" CornerRadius="2"/>
          </Border>
        </StackPanel>
        </Grid>

        <!-- Marker selected: "Split at MM:SS.mmm · K of N confirmed · ..." -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Visibility="{Binding SelectionKind, Converter={StaticResource EnumEqVis}, ConverterParameter=Marker}">
          <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="12" Text="Split at "/>
          <TextBlock Foreground="{StaticResource Text.Primary}" FontWeight="Medium" FontSize="12"
                     FontFamily="{StaticResource Font.Mono}"
                     Text="{Binding SelectedMarker.TimeUs, Converter={StaticResource TimeFmt}}"/>
          <TextBlock Text=" · " Foreground="{StaticResource Text.Tertiary}" FontSize="12"/>
          <TextBlock Foreground="{StaticResource Text.Primary}" FontWeight="Medium" FontSize="12"
                     Text="{Binding ConfirmProgressLabel}"/>
          <TextBlock Text=" splits confirmed · drag or ←/→ to nudge, press "
                     Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
          <Border Background="{StaticResource Bg.Surface2}" BorderBrush="{StaticResource Border.Subtle}"
                  BorderThickness="1" CornerRadius="3" Padding="5,0">
            <TextBlock Text="C" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Text.Primary}" FontSize="12"/>
          </Border>
          <TextBlock Text=" to confirm" Foreground="{StaticResource Text.Secondary}" FontSize="12"/>
        </StackPanel>

        <!-- Segment selected -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Visibility="{Binding SelectionKind, Converter={StaticResource EnumEqVis}, ConverterParameter=Segment}">
          <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="12" Text="Segment selected · "/>
          <TextBlock Foreground="{StaticResource Text.Primary}" FontSize="12" FontFamily="{StaticResource Font.Mono}"
                     Text="{Binding SelectedSegment.DurationUs, Converter={StaticResource TimeFmt}}"/>
        </StackPanel>
        </Grid>

        <!-- Right cluster: Zoom | Output | Version (file loaded), or just
             Version (no file). Dividers match the left side's spec. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding ZoomFactor, StringFormat=Zoom {0:0.0}×}" FontFamily="{StaticResource Font.Mono}"
                     Foreground="{StaticResource Text.Tertiary}" FontSize="12"
                     Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}"/>
          <Rectangle Width="1" Height="14" Fill="{StaticResource Border.Subtle}" Margin="16,0"
                     Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}"/>
          <TextBlock Text="Output " Foreground="{StaticResource Text.Secondary}" FontSize="12"
                     Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}"/>
          <TextBlock Text="{Binding ExpectedOutputDurationUs, Converter={StaticResource TimeFmt}, FallbackValue=--:--}" FontFamily="{StaticResource Font.Mono}"
                     Foreground="{StaticResource Text.Primary}" FontSize="12"
                     Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}"/>
          <Rectangle Width="1" Height="14" Fill="{StaticResource Border.Subtle}" Margin="16,0"
                     Visibility="{Binding IsFileLoaded, Converter={StaticResource Bool2Vis}}"/>
          <TextBlock Text="{x:Static app:AppVersion.Display}" FontFamily="{StaticResource Font.Mono}"
                     Foreground="{StaticResource Text.Tertiary}" FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
