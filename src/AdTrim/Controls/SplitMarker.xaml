<UserControl x:Class="AdTrim.Controls.SplitMarker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AdTrim.Converters"
             x:Name="Self"
             IsHitTestVisible="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

  <UserControl.Resources>
    <conv:ConfidenceToBrushConverter x:Key="Confidence2Brush"/>
    <conv:MarkerFillConverter x:Key="MarkerFill"/>
    <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
  </UserControl.Resources>

  <!-- The marker occupies a 30px-wide column above + through the ruler.
       Triangle is drawn at the top. Stem hangs down through the ruler band. -->
  <Grid Width="30" Height="58">

    <!-- Selection halo (square behind the triangle) -->
    <Rectangle x:Name="Halo"
               Width="22" Height="22"
               RadiusX="4" RadiusY="4"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,4,0,0"
               Fill="#2E7C5CFF"
               Stroke="{StaticResource Accent.Base}" StrokeThickness="1"
               Visibility="{Binding IsSelected, ElementName=Self, Converter={StaticResource Bool2Vis}}"/>

    <!-- Stem: from below the triangle through the ruler.
         Confirmed = 1.5px solid; Unconfirmed = 1px dashed. -->
    <Canvas x:Name="StemHost" Width="2" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,19,0,0">
      <Line x:Name="StemSolid"
            X1="0.5" Y1="0" X2="0.5" Y2="39"
            StrokeThickness="1.5"
            Visibility="Collapsed"/>
      <Line x:Name="StemDashed"
            X1="0.5" Y1="0" X2="0.5" Y2="39"
            StrokeThickness="1"
            StrokeDashArray="3 3"
            Visibility="Visible"/>
    </Canvas>

    <!-- Triangle (down-pointing) at top -->
    <Polygon x:Name="Triangle"
             Points="1.5,1.5 12.5,1.5 7,11"
             Width="14" Height="14"
             HorizontalAlignment="Center" VerticalAlignment="Top"
             Margin="0,8,0,0"
             StrokeThickness="1.6"
             StrokeLineJoin="Round"/>

    <!-- Audition button (shows when selected) - sits above triangle -->
    <Border x:Name="AuditionChip"
            VerticalAlignment="Top" HorizontalAlignment="Center"
            Margin="0,-22,0,0"
            Background="{StaticResource Bg.Elevated}"
            BorderBrush="{StaticResource Border.Strong}" BorderThickness="1"
            CornerRadius="4" Padding="6,3,7,3"
            Visibility="{Binding ShowAudition, ElementName=Self, Converter={StaticResource Bool2Vis}}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.45"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Polygon Points="0,0 6,3 0,6" Fill="{StaticResource Accent.Base}"
                 VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBlock Text="Preview ±2s" Style="{StaticResource Text.Body}" FontSize="11" FontWeight="Medium"/>
      </StackPanel>
    </Border>

    <!-- Optional label under the ruler (e.g. Start / End) -->
    <TextBlock x:Name="LabelTb"
               Text="{Binding Label, ElementName=Self}"
               VerticalAlignment="Bottom" HorizontalAlignment="Center"
               FontFamily="{StaticResource Font.Mono}"
               FontSize="10"
               Foreground="{StaticResource Text.Tertiary}"
               Margin="0,0,0,0"/>
  </Grid>
</UserControl>
