<UserControl x:Class="AdTrim.Controls.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:AdTrim.Controls"
             x:Name="Self"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             ClipToBounds="False">

  <Border Background="{StaticResource Bg.Surface2}" CornerRadius="4" Padding="10,8,10,6"
          BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0"
          MouseLeftButtonDown="OnBackgroundClicked"
          MouseRightButtonUp="OnBackgroundContextMenu"
          MouseMove="OnTimelineHover"
          MouseLeave="OnTimelineLeave">
    <Grid x:Name="LayoutRoot" SizeChanged="LayoutRoot_SizeChanged" ClipToBounds="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>   <!-- marker lane -->
        <RowDefinition Height="22"/>   <!-- ruler -->
        <RowDefinition Height="4"/>    <!-- gap -->
        <RowDefinition Height="56"/>   <!-- thumbnail strip + segments -->
        <RowDefinition Height="4"/>    <!-- gap -->
        <RowDefinition Height="38"/>   <!-- waveform -->
      </Grid.RowDefinitions>

      <!-- Marker lane (Canvas so markers can be absolutely positioned) -->
      <Canvas x:Name="MarkerLane" Grid.Row="0" Background="Transparent" ClipToBounds="False"/>

      <!-- Ruler (lane with ticks + labels) -->
      <Border Grid.Row="1" Background="{StaticResource Bg.Lane}"
              BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1"
              CornerRadius="3">
        <Canvas x:Name="RulerCanvas" Background="Transparent"/>
      </Border>

      <!-- Thumbnail strip with segments overlay -->
      <Border Grid.Row="3" Background="{StaticResource Bg.Lane}"
              CornerRadius="3" ClipToBounds="True">
        <Grid>
          <Canvas x:Name="ThumbCanvas"/>
          <Canvas x:Name="SegmentLayer" ClipToBounds="False"/>
        </Grid>
      </Border>

      <!-- Waveform -->
      <Border Grid.Row="5" Background="{StaticResource Bg.Lane}" CornerRadius="3"
              ClipToBounds="True">
        <Canvas x:Name="WaveformCanvas"/>
      </Border>

      <!-- Playhead overlay (spans all rows, sits above everything) -->
      <Grid Grid.Row="0" Grid.RowSpan="6" IsHitTestVisible="False" ClipToBounds="False">
        <Canvas x:Name="PlayheadCanvas" ClipToBounds="False"/>
      </Grid>

      <!-- Hover indicator: vertical line + time label that follow the cursor.
           Hidden until the user moves the mouse over the timeline. -->
      <Grid Grid.Row="0" Grid.RowSpan="6" IsHitTestVisible="False" ClipToBounds="False">
        <Canvas x:Name="HoverCanvas" ClipToBounds="False"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
