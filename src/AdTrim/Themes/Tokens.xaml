<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- =================================================================== -->
  <!-- Color tokens - mirror of design tokens.md / tokens.jsx               -->
  <!-- =================================================================== -->

  <!-- Surfaces & chrome -->
  <Color x:Key="Bg.Window.Color">#FF0E0E10</Color>
  <Color x:Key="Bg.Surface.Color">#FF16161A</Color>
  <Color x:Key="Bg.Surface2.Color">#FF1D1D22</Color>
  <Color x:Key="Bg.Lane.Color">#FF25252B</Color>
  <Color x:Key="Bg.LaneAlt.Color">#FF2A2A31</Color>
  <Color x:Key="Bg.Elevated.Color">#FF23232A</Color>
  <Color x:Key="Border.Subtle.Color">#FF2A2A30</Color>
  <Color x:Key="Border.Strong.Color">#FF36363E</Color>

  <!-- Text -->
  <Color x:Key="Text.Primary.Color">#FFE8E8EC</Color>
  <Color x:Key="Text.Secondary.Color">#FF9A9AA3</Color>
  <Color x:Key="Text.Tertiary.Color">#FF6B6B75</Color>
  <Color x:Key="Text.OnAccent.Color">#FF0B1224</Color>

  <!-- Accent & state -->
  <Color x:Key="Accent.Base.Color">#FF4F8CFF</Color>
  <Color x:Key="Accent.Hover.Color">#FF6BA0FF</Color>
  <Color x:Key="Accent.Press.Color">#FF3A78F0</Color>
  <Color x:Key="Accent.Soft.Color">#FF1E2A44</Color>
  <Color x:Key="State.Danger.Color">#FFFF6B6B</Color>
  <!-- Saturated red specifically for filled danger backgrounds (Button.Danger).
       State.Danger is intentionally light for strokes/foregrounds on dark
       surfaces; that same color as a full background reads as salmon. -->
  <Color x:Key="State.DangerStrong.Color">#FFD32F2F</Color>
  <Color x:Key="State.Warning.Color">#FFF5B84A</Color>
  <Color x:Key="State.Success.Color">#FF3EC5A6</Color>

  <!-- Marker confidence -->
  <Color x:Key="Marker.Neutral.Color">#FF9CA0AB</Color>
  <Color x:Key="Marker.High.Color">#FF3EC5A6</Color>
  <Color x:Key="Marker.Medium.Color">#FFF5B84A</Color>
  <Color x:Key="Marker.Low.Color">#FFFF6B6B</Color>
  <Color x:Key="Marker.Unchanged.Color">#FF6B6B75</Color>
  <Color x:Key="Marker.SelectedHalo.Color">#FF7C5CFF</Color>

  <!-- Segments -->
  <Color x:Key="Segment.Default.Color">#FF2D2D34</Color>
  <Color x:Key="Segment.Selected.Color">#FF1E2A44</Color>
  <Color x:Key="Segment.Excluded.Bg.Color">#FF1A1A1F</Color>
  <Color x:Key="Segment.Excluded.Stripe.Color">#FF2A2A31</Color>

  <!-- =================================================================== -->
  <!-- Brushes                                                              -->
  <!-- =================================================================== -->
  <SolidColorBrush x:Key="Bg.Window"     Color="{StaticResource Bg.Window.Color}"/>
  <SolidColorBrush x:Key="Bg.Surface"    Color="{StaticResource Bg.Surface.Color}"/>
  <SolidColorBrush x:Key="Bg.Surface2"   Color="{StaticResource Bg.Surface2.Color}"/>
  <SolidColorBrush x:Key="Bg.Lane"       Color="{StaticResource Bg.Lane.Color}"/>
  <SolidColorBrush x:Key="Bg.LaneAlt"    Color="{StaticResource Bg.LaneAlt.Color}"/>
  <SolidColorBrush x:Key="Bg.Elevated"   Color="{StaticResource Bg.Elevated.Color}"/>
  <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Border.Subtle.Color}"/>
  <SolidColorBrush x:Key="Border.Strong" Color="{StaticResource Border.Strong.Color}"/>

  <SolidColorBrush x:Key="Text.Primary"   Color="{StaticResource Text.Primary.Color}"/>
  <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}"/>
  <SolidColorBrush x:Key="Text.Tertiary"  Color="{StaticResource Text.Tertiary.Color}"/>
  <SolidColorBrush x:Key="Text.OnAccent"  Color="{StaticResource Text.OnAccent.Color}"/>

  <SolidColorBrush x:Key="Accent.Base"  Color="{StaticResource Accent.Base.Color}"/>
  <SolidColorBrush x:Key="Accent.Hover" Color="{StaticResource Accent.Hover.Color}"/>
  <SolidColorBrush x:Key="Accent.Press" Color="{StaticResource Accent.Press.Color}"/>
  <SolidColorBrush x:Key="Accent.Soft"  Color="{StaticResource Accent.Soft.Color}"/>
  <SolidColorBrush x:Key="State.Danger" Color="{StaticResource State.Danger.Color}"/>
  <SolidColorBrush x:Key="State.DangerStrong" Color="{StaticResource State.DangerStrong.Color}"/>
  <SolidColorBrush x:Key="State.Warning" Color="{StaticResource State.Warning.Color}"/>
  <SolidColorBrush x:Key="State.Success" Color="{StaticResource State.Success.Color}"/>

  <SolidColorBrush x:Key="Marker.Neutral"      Color="{StaticResource Marker.Neutral.Color}"/>
  <SolidColorBrush x:Key="Marker.High"         Color="{StaticResource Marker.High.Color}"/>
  <SolidColorBrush x:Key="Marker.Medium"       Color="{StaticResource Marker.Medium.Color}"/>
  <SolidColorBrush x:Key="Marker.Low"          Color="{StaticResource Marker.Low.Color}"/>
  <SolidColorBrush x:Key="Marker.Unchanged"    Color="{StaticResource Marker.Unchanged.Color}"/>
  <SolidColorBrush x:Key="Marker.SelectedHalo" Color="{StaticResource Marker.SelectedHalo.Color}"/>

  <SolidColorBrush x:Key="Segment.Default"        Color="{StaticResource Segment.Default.Color}"/>
  <SolidColorBrush x:Key="Segment.Selected"       Color="{StaticResource Segment.Selected.Color}"/>
  <SolidColorBrush x:Key="Segment.Excluded.Bg"    Color="{StaticResource Segment.Excluded.Bg.Color}"/>
  <SolidColorBrush x:Key="Segment.Excluded.Stripe" Color="{StaticResource Segment.Excluded.Stripe.Color}"/>

  <!-- Soft tinted brushes for selection/excluded fills (with alpha) -->
  <SolidColorBrush x:Key="Accent.SelectionFill" Color="#2E4F8CFF"/>
  <SolidColorBrush x:Key="State.WarningTint"    Color="#1AF5B84A"/>
  <SolidColorBrush x:Key="State.DangerTint"     Color="#12FF6B6B"/>

  <!-- =================================================================== -->
  <!-- Typography                                                           -->
  <!-- =================================================================== -->
  <FontFamily x:Key="Font.UI">Segoe UI, system-ui</FontFamily>
  <FontFamily x:Key="Font.Mono">Consolas, ui-monospace</FontFamily>

  <sys:Double x:Key="Type.SectionLabel.Size">11</sys:Double>
  <sys:Double x:Key="Type.Body.Size">13</sys:Double>
  <sys:Double x:Key="Type.Button.Size">13</sys:Double>
  <sys:Double x:Key="Type.AppName.Size">13</sys:Double>
  <sys:Double x:Key="Type.Filename.Size">12</sys:Double>
  <sys:Double x:Key="Type.TransportTime.Size">20</sys:Double>
  <sys:Double x:Key="Type.RulerTick.Size">10</sys:Double>
  <sys:Double x:Key="Type.StatusBar.Size">12</sys:Double>
  <sys:Double x:Key="Type.DialogTitle.Size">18</sys:Double>
  <sys:Double x:Key="Type.DropCta.Size">22</sys:Double>

  <!-- =================================================================== -->
  <!-- Heights / spacing tokens                                             -->
  <!-- =================================================================== -->
  <sys:Double x:Key="Chrome.TitleBar.Height">32</sys:Double>
  <sys:Double x:Key="AppBar.Height">32</sys:Double>
  <sys:Double x:Key="StatusBar.Height">26</sys:Double>
  <sys:Double x:Key="TransportBar.Height">56</sys:Double>
  <sys:Double x:Key="TimelineToolbar.Height">40</sys:Double>
  <sys:Double x:Key="Timeline.Height">174</sys:Double>

  <!-- =================================================================== -->
  <!-- Diagonal-stripe brushes for excluded segments                        -->
  <!-- (crosshatch is the design default per editmode tweak default)        -->
  <!-- =================================================================== -->
  <DrawingBrush x:Key="Stripe.Diagonal" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute"
                Viewbox="0,0,12,12" ViewboxUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource Segment.Excluded.Bg}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,12,12"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Segment.Excluded.Stripe}">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="0,5,16,1" Transform="{x:Null}"/>
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
    <DrawingBrush.Transform>
      <RotateTransform Angle="135" CenterX="6" CenterY="6"/>
    </DrawingBrush.Transform>
  </DrawingBrush>

  <DrawingBrush x:Key="Stripe.Crosshatch" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute"
                Viewbox="0,0,10,10" ViewboxUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource Segment.Excluded.Bg}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,10,10"/>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Segment.Excluded.Stripe}">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource Segment.Excluded.Stripe}" Thickness="1"/>
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <LineGeometry StartPoint="0,0" EndPoint="10,10"/>
              <LineGeometry StartPoint="0,10" EndPoint="10,0"/>
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Accent-stroked crosshatch for selected + excluded segments. Transparent
       background so the soft accent fill on the host Border shows through. -->
  <DrawingBrush x:Key="Stripe.Crosshatch.Accent" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute"
                Viewbox="0,0,10,10" ViewboxUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource Accent.Base}">
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource Accent.Base}" Thickness="1"/>
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <LineGeometry StartPoint="0,0" EndPoint="10,10"/>
              <LineGeometry StartPoint="0,10" EndPoint="10,0"/>
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- =================================================================== -->
  <!-- Drop shadows                                                         -->
  <!-- =================================================================== -->
  <DropShadowEffect x:Key="Shadow.Menu" BlurRadius="32" ShadowDepth="12"
                    Direction="270" Color="Black" Opacity="0.45"/>
  <DropShadowEffect x:Key="Shadow.Dialog" BlurRadius="64" ShadowDepth="24"
                    Direction="270" Color="Black" Opacity="0.55"/>

</ResourceDictionary>
